---
import GlyphIcon from "../../components/GlyphIcon.astro";
import Layout from "../../layouts/Layout.astro";
import JournalCard from "../../components/journal/JournalCard.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import ArrowMark from "../../components/ArrowMark.astro";
import FigmaPanel from "../../components/figma/FigmaPanel.astro";
import SelectionFrame from "../../components/figma/SelectionFrame.astro";
import Img from "../../components/Img.astro";
import { POSTS, AUTHOR } from "../../data/journal";
import { absoluteUrl } from "../../lib/site";

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const more = POSTS.filter((p) => p.slug !== post.slug).slice(0, 3);
const path = `/journal/${post.slug}/`;
const metaTitle = post.seoTitle ?? `${post.title} · Ilmantara`;
const metaDescription = post.metaDescription ?? post.excerpt;

// Split body lines into paragraphs and heading blocks ("## " / "### ").
const BLOCKS = post.body.map((line) => {
  if (line.startsWith("### ")) return { kind: "h3" as const, text: line.slice(4) };
  if (line.startsWith("## ")) return { kind: "h2" as const, text: line.slice(3) };
  return { kind: "p" as const, text: line };
});

const MONTHS: Record<string, string> = {
  Jan: "01", Feb: "02", Mar: "03", Apr: "04", Mei: "05", Jun: "06",
  Jul: "07", Agu: "08", Sep: "09", Okt: "10", Nov: "11", Des: "12",
};
function isoDate(value: string): string | undefined {
  const m = value.match(/^(\d{1,2})\s+(\w+)\s+(\d{4})$/);
  const month = m ? MONTHS[m[2]] : undefined;
  return m && month ? `${m[3]}-${month}-${m[1].padStart(2, "0")}` : undefined;
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: metaDescription,
  image: absoluteUrl(post.cover),
  mainEntityOfPage: absoluteUrl(path),
  ...(isoDate(post.date) ? { datePublished: isoDate(post.date) } : {}),
  author: { "@type": "Organization", name: AUTHOR.name, url: absoluteUrl("/") },
  publisher: { "@type": "Organization", name: "Ilmantara", url: absoluteUrl("/") },
};

function rich(text: string) {
  return text.split(/(\[[^\]]+\]\([^)]+\))/g).map((part) => {
    const m = part.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { link: m[2], text: m[1] } : { text: part };
  });
}
---

<Layout
  path={path}
  lang="id"
  title={metaTitle}
  description={metaDescription}
  image={post.cover}
  ogType="article"
  jsonLd={[articleSchema]}
  alternates={[
    { hreflang: "id", href: path },
    { hreflang: "x-default", href: path },
  ]}
>
  <div class="relative overflow-hidden bg-paper text-ink">
    <!-- Figma canvas: dotted grid over the paper background -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-[.55]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(12,12,14,0.16) 1px, transparent 1.2px); background-size: 24px 24px;"
    >
    </div>

    <article class="relative mx-auto max-w-[1312px] px-5 pb-24 pt-[120px] sm:px-8 md:pt-[150px] lg:px-16">
      <!-- Breadcrumb: canvas file label -->
      <div class="mx-auto flex max-w-[900px] items-center gap-2.5 font-mono text-[11px] font-medium uppercase leading-none tracking-[0.05em] text-ink/65">
        <span class="text-accent" aria-hidden="true">#</span>
        <a href="/journal/" class="hover:text-accent">Jurnal</a>
        <span class="opacity-50">/</span>
        <span class="truncate text-ink capitalize">{post.slug}</span>
        <span class="ml-auto hidden text-ink/65 sm:inline">{post.readTime}</span>
      </div>

      <!-- 01 Post header -->
      <header class="mx-auto mt-10 max-w-[900px] text-center">
        <h1 class="mt-5 text-balance text-[clamp(44px,7vw,88px)] font-semibold leading-[0.98] tracking-[-0.04em]">
          {post.title}
        </h1>
        <p class="mx-auto mt-6 max-w-[720px] text-balance text-[19px] leading-[1.5] text-ink/70 md:text-[21px]">
          {post.excerpt}
        </p>
      </header>

      <!-- 02 Cover: selected frame with handles + dimension chip -->
      <figure class="relative mt-10 md:mt-14">
        <div class="mb-2.5 flex items-center gap-1.5 font-mono text-[10px] font-medium leading-none text-accent">
          <GlyphIcon name="diamond" />
          <span>Gambar</span>
          <span class="ml-auto text-ink/65">16 : 9</span>
        </div>
        <div class="relative">
          <div class="overflow-hidden rounded-md border border-ink/10">
            <Img src={post.cover} alt={post.coverAlt} sizes="(min-width: 1312px) 1184px, 100vw" fetchpriority="high" class="aspect-[16/9] w-full object-cover" />
          </div>
          <SelectionFrame label="1440 × 810" />
        </div>
      </figure>

      <!-- 03 Body -->
      <div class="mx-auto mt-10 max-w-[720px] md:mt-14">
        {post.body.map((para) => (
          <p class="mb-6 text-[18px] leading-[1.65] tracking-[-0.01em] text-ink/80 last:mb-0">
            {rich(para).map((seg) =>
              "link" in seg && seg.link ? (
                <a href={seg.link} class="font-medium text-accent underline underline-offset-2 hover:text-ink">
                  {seg.text}
                </a>
              ) : (
                seg.text
              ),
            )}
          </p>
        ))}
      </div>

      <!-- 04 Author: chrome panel -->
      <FigmaPanel frame="Penulis" meta="Profil" tabs={["Catatan", "Kontak"]} class="mx-auto mt-12 max-w-[720px] md:mt-16">
        <aside class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-semibold text-white" aria-hidden="true">
            {AUTHOR.initials}
          </span>
          <div class="min-w-0">
            <p class="text-[15px] font-semibold text-ink">
              {`Ditulis oleh ${AUTHOR.name}`}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-ink/60">{AUTHOR.bioId}</p>
          </div>
          <a
            href={`mailto:${AUTHOR.email}`}
            class="group inline-flex shrink-0 items-center gap-2 text-sm font-medium text-ink underline underline-offset-4 hover:text-accent sm:ml-auto"
          >
            {"Sapa kami "}<ArrowMark />
          </a>
        </aside>
      </FigmaPanel>

      <!-- 05 Esai lain -->
      <section aria-label="Tulisan lain" class="mt-16 md:mt-24">
        <div class="mb-4 flex items-center gap-2 font-mono text-[11px] font-medium leading-none">
          <span class="text-accent" aria-hidden="true">#</span>
          <span class="text-ink/70">Tulisan Lain</span>
          <span class="ml-auto text-ink/65">{more.length} esai</span>
        </div>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-[36px] font-semibold leading-[1.02] tracking-[-0.03em] md:text-[48px]">
            {"Tulisan lain"}
          </h2>
          <ArrowLink href="/journal/" label="Semua tulisan" tone="ink" size="text-sm" class="pb-1" />
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {more.map((p) => (
            <JournalCard post={p} />
          ))}
        </div>
      </section>
    </article>
  </div>
</Layout>
