---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/home/Clients.astro";
import AboutTeaser from "../components/home/AboutTeaser.astro";
import SelectedWork from "../components/home/SelectedWork.astro";
import Services from "../components/home/Services.astro";
import Process from "../components/home/Process.astro";
import Testimonials from "../components/home/Testimonials.astro";
import PlaygroundTeaser from "../components/home/PlaygroundTeaser.astro";
import FAQ from "../components/home/FAQ.astro";
import { FAQS } from "../data/faq";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  path="/"
  lang="id"
  alternates={[
    { hreflang: "id", href: "/" },
    { hreflang: "x-default", href: "/" },
  ]}
  jsonLd={[faqSchema]}
>
  <Hero />
  <Clients />
  <AboutTeaser />
  <SelectedWork />
  <Services />
  <Process />
  <Testimonials />
  <PlaygroundTeaser />
  <FAQ />
</Layout>
