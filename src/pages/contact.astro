---
import Layout from "../layouts/Layout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import ArrowMark from "../components/ArrowMark.astro";
import { EMAIL, WHATSAPP_LINK, PHONE_DISPLAY, MAPS_LINK, OPENING_HOURS_DISPLAY } from "../lib/site";

const TITLE = "Hubungi Kami – Konsultasi Gratis | Ilmantara";
const DESCRIPTION =
  "Hubungi Ilmantara, software house di Yogyakarta. Konsultasi gratis via WhatsApp, dibalas 1 hari kerja dengan ide awal dan estimasi harga. Hubungi sekarang.";
---

<Layout
  path="/contact/"
  lang="id"
  title={TITLE}
  description={DESCRIPTION}
  alternates={[
    { hreflang: "id", href: "/contact/" },
    { hreflang: "x-default", href: "/contact/" },
  ]}
>
  <div class="bg-paper text-ink">
    <div class="mx-auto max-w-[1312px] px-5 pb-24 pt-[120px] sm:px-8 md:pt-[150px] lg:px-16">
      <p class="flex items-center gap-2.5 font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/65">
        <b class="font-medium text-accent">[Kontak]</b> Hubungi kami
      </p>
      <h1 class="mt-[18px] max-w-[800px] text-balance text-[44px] font-semibold leading-[1.02] tracking-[-0.04em] md:text-[64px]">
        Ceritakan kebutuhan website Anda
      </h1>
      <p class="mt-5 max-w-[640px] text-[18px] leading-[1.55] text-ink/70">
        Kami bantu UMKM dan brand membuat website, landing page, toko online
        Shopify, dan aplikasi web. Balasan dalam 1 hari kerja dengan ide awal
        dan estimasi harga tetap.
      </p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <a
          href={WHATSAPP_LINK}
          target="_blank"
          rel="noopener"
          class="group rounded-2xl border border-ink/[0.09] bg-ink p-6 text-white shadow-[0_26px_50px_-38px_rgba(12,12,14,0.55)] transition-all duration-300 hover:-translate-y-1"
        >
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-white/60">Paling cepat</p>
          <p class="mt-3 text-[24px] font-semibold tracking-[-0.02em]">Chat WhatsApp</p>
          <p class="mt-2 text-[15px] leading-relaxed text-white/70">
            {PHONE_DISPLAY} · konsultasi gratis, balas 1 hari kerja.
          </p>
          <p class="mt-4 inline-flex items-center gap-2 text-[15px] font-medium">
            Mulai chat <ArrowMark />
          </p>
        </a>
        <div class="rounded-2xl border border-ink/[0.09] bg-white p-6 shadow-[0_26px_50px_-38px_rgba(12,12,14,0.35)]">
          <p class="font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/65">Email</p>
          <p class="mt-3 text-[24px] font-semibold tracking-[-0.02em]">{EMAIL}</p>
          <p class="mt-2 text-[15px] leading-relaxed text-ink/60">
            Untuk brief panjang, kirim email. Kami balas 1 hari kerja.
          </p>
          <ArrowLink href={`mailto:${EMAIL}`} label="Kirim email" tone="accent" class="mt-4 inline-block" />
        </div>
      </div>

      <div class="mt-4 rounded-2xl border border-ink/[0.09] bg-white p-6">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/65">Alamat</p>
        <p class="mt-3 text-[17px] font-medium">Ilmantara · Software House Jogja · Jalan Nangka, Wedomartani, Ngemplak, Sleman, DI Yogyakarta 55584, Indonesia</p>
        <ArrowLink href={MAPS_LINK} external label="Lokasi Kantor" tone="accent" class="mt-2 inline-block" />
        <p class="mt-4 font-mono text-[11px] font-medium uppercase tracking-[0.05em] text-ink/65">Jam operasional</p>
        <p class="mt-1 text-[15px] font-medium text-ink/80">{OPENING_HOURS_DISPLAY}</p>
      </div>
    </div>
  </div>
</Layout>
