---
const technologies = ['Web Development', 'Shopify', 'Laravel', 'Symfony', 'React', 'AI Integration'];
---
<ul aria-label="Studio technologies" data-about-tags class="mt-[30px] flex flex-wrap gap-[6px]">
  {technologies.map(tag => <li class="rounded-full bg-ink/5 px-3 py-[9px] text-[13px] font-medium leading-none transition-colors duration-200 hover:bg-accent hover:text-white motion-reduce:transition-none">{tag}</li>)}
</ul>
