---
import MazeGame from "./MazeGame.astro";
---

<section id="playground" data-framer-name="09 Playground" class="relative scroll-mt-14 overflow-hidden bg-paper">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgb(var(--color-ink-rgb)/.16)_1px,transparent_1.2px)] bg-[size:24px_24px] opacity-90"
  ></div>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(1200px_520px_at_50%_34%,rgba(255,255,255,0.75),transparent_70%)]"
  ></div>
  <div class="relative mx-auto max-w-[1312px] px-5 py-24 sm:px-8 lg:px-16">
    <div class="w-full">
      <p class="font-mono text-xs font-medium tracking-wide text-ink/65">
        <span class="text-accent"># Ilmantara /</span> Permainan
      </p>

      <h2 class="mt-4 text-[40px] font-bold leading-[1.05] tracking-[-0.02em] text-ink md:text-[56px]">
        Bermain dengan Logika
      </h2>

      <p class="mt-5 w-full text-ink/70">
        Permainan kecil untuk ide besar. Susun logikamu dengan blok visual,
        selesaikan maze-nya, dan lihat kodemu hidup.
      </p>
    </div>

    <div class="mt-10">
      <MazeGame />
    </div>
  </div>
</section>
