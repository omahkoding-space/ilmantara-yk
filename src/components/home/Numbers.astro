---
const STATS = [
  { chip: "W", index: "01", value: "9", suffix: null, text: "designing software for teams of 5 to 5,000" },
  { chip: "H", index: "02", value: "31", suffix: null, text: "shipped to production, and still running" },
  { chip: "X", index: "03", value: "4.2", suffix: "M", text: "people use them every month" },
  { chip: "Y", index: "04", value: "12", suffix: null, text: "design systems built and documented" },
];

const WAVEFORM_BARS = Array.from({ length: 56 }, (_, i) => {
  const height = 20 + Math.round(Math.abs(Math.sin(i * 0.7)) * 60 + (i % 5) * 4);
  return Math.min(height, 100);
});
const splitAt = Math.round(WAVEFORM_BARS.length * 0.6);
---

<section data-framer-name="05 Numbers" class="px-6 py-24 md:px-10 md:pb-52">
  <p class="font-mono text-xs font-medium tracking-wide">
    <span class="text-accent">[05]</span> <span class="text-ink/65">IN NUMBERS</span>
  </p>

  <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-[56px] font-bold leading-[1.05] tracking-[-0.03em] text-ink">The file so far</h2>
    <span class="font-mono text-xs tracking-wide text-ink/65">UPDATED SEP 2026</span>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {STATS.map((stat) => (
      <div class="rounded-2xl border border-ink/10 bg-white p-6">
        <div class="flex items-center justify-between">
          <span class="flex h-5 w-5 items-center justify-center rounded bg-accent/10 font-mono text-[11px] font-medium text-accent">
            {stat.chip}
          </span>
          <span class="font-mono text-xs text-ink/65">{stat.index}</span>
        </div>
        <p class="mt-5 text-[56px] font-bold leading-none tracking-[-0.03em] text-ink">
          {stat.value}
          {stat.suffix && <span class="ml-1 text-2xl font-semibold text-ink/65">{stat.suffix}</span>}
        </p>
        <p class="mt-4 text-sm text-ink/60">{stat.text}</p>

        <div class="relative mt-6">
          <div class="flex h-6 items-end gap-[3px]">
            {WAVEFORM_BARS.map((height, i) => (
              <span
                class={`w-px flex-1 ${i < splitAt ? "bg-accent" : "bg-ink/20"}`}
                style={`height: ${height}%;`}
              />
            ))}
          </div>
          <div
            class="absolute bottom-0 left-0 h-px bg-accent"
            style={`width: ${(splitAt / WAVEFORM_BARS.length) * 100}%;`}
          ></div>
        </div>
      </div>
    ))}
  </div>
</section>
