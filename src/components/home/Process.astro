---
const { active = "01" } = Astro.props;
// Home dan work memakai behaviour yang sama seperti referensi
// (expanding-row): card aktif membesar, hover pindah aktif.

// Static content — CMS integration removed, edit directly here.
const STEPS = [
  {
    index: "01",
    week: "MINGGU 1",
    title: "Konsultasi",
    shortBody: "Memahami kebutuhan Anda",
    fullBody:
      "Kami mempelajari bisnis, pelanggan, dan kendala Anda untuk memahami apa yang perlu dibangun. Tanpa asumsi, cukup pertanyaan yang tepat.",
  },
  {
    index: "02",
    week: "MINGGU 1-2",
    title: "Perencanaan & Estimasi",
    shortBody: "Lingkup dan harga yang jelas",
    fullBody:
      "Kami menetapkan lingkup, fitur, dan pendekatan teknis, mengubah ide Anda menjadi rencana yang jelas dengan estimasi harga tetap.",
  },
  {
    index: "03",
    week: "MINGGU 2-6",
    title: "Desain & Pengembangan",
    shortBody: "Membangun frontend dan backend",
    fullBody:
      "Kami mendesain dan membangun frontend, backend, API, dan database, menguji setiap bagian agar semuanya berjalan bersama.",
  },
  {
    index: "04",
    week: "MINGGU 6+",
    title: "Peluncuran & Dukungan",
    shortBody: "Rilis dan pendampingan",
    fullBody:
      "Kami meluncurkan produk Anda, mengujinya di produksi, memperbaiki masalah, dan mengoptimasi performa agar tetap berjalan lancar.",
  },
];

const CARD_BG = {
  light: "bg-ink/[0.06] text-ink",
  dark: "bg-ink text-white",
  white: "bg-white text-ink",
};

const CARD_BORDER = {
  light: "border-ink/[0.08]",
  dark: "border-ink",
  white: "border-ink/[0.08]",
};

const META_COLOR = {
  light: "text-ink/70",
  dark: "text-white/70",
  white: "text-ink/70",
};

const BODY_COLOR = {
  light: "text-ink/75",
  dark: "text-white/75",
  white: "text-ink/75",
};
---

<section data-framer-name="07 Process" class="mx-auto max-w-[1312px] px-5 py-24 sm:px-8 md:pb-44 lg:px-16">
  <p class="font-mono text-xs font-medium tracking-wide">
    <span class="text-accent"># Ilmantara /</span> <span class="text-ink/65">Proses</span>
  </p>

  <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-[40px] font-bold leading-[1.05] tracking-[-0.02em] text-ink md:text-[48px]">
        Cara Kami Bekerja
      </h2>

      <p class="mt-4 max-w-[640px] text-ink/70">
        Tanpa tebak-tebakan, tanpa kerumitan yang tidak perlu. Proses yang jelas
        dari memahami kebutuhan Anda sampai meluncurkan solusi yang tepat.
      </p>
    </div>
    <span data-process-count class="shrink-0 rounded-full bg-ink/5 px-3 py-1 font-mono text-xs text-ink/65">Langkah {Number(active)} / {STEPS.length}</span>
  </div>

  <div
    class="mt-6 flex flex-col gap-6 rounded-[20px] border-[1.5px] border-dashed border-accent/50 p-3.5 sm:p-6 min-[1000px]:min-h-[360px] min-[1000px]:flex-row"
    data-process-steps
    data-expandable=""
  >
    {STEPS.map((step) => {
    const isActive = step.index === active;
    const variant = isActive ? "dark" : "white";
    const body = step.fullBody;
    const bodyVisible = isActive;
    return (
      <div
        data-process-step={step.index}
        data-full-body={step.fullBody ?? ""}
        class={`flex flex-col justify-between rounded-[14px] border p-5 min-[1000px]:flex-1 ${isActive ? "min-[1000px]:grow-[2.3]" : "min-[1000px]:grow"} ${CARD_BG[variant]} ${CARD_BORDER[variant]}`}
        style="transition: flex-grow .9s cubic-bezier(.22,1,.36,1), background-color .5s, color .5s, border-color .5s;"
      >
        <div data-process-meta class={`flex items-center justify-between text-[11px] font-medium uppercase leading-none tracking-[0.05em] font-mono ${META_COLOR[variant]}`}>
          <span>{step.index}</span>
          <span>{step.week}</span>
        </div>
        <div class="mt-7 min-[1000px]:mt-0">
          <h3 class="text-[34px] font-semibold leading-none tracking-[-0.05em]">{step.title}</h3>
          <p
            data-process-body
            data-body-visible={bodyVisible ? "" : undefined}
            class={`mt-3 max-w-[420px] overflow-hidden text-[15px] leading-[1.5] transition-[max-height,opacity,margin] duration-500 ease-out ${bodyVisible ? "min-[1000px]:mt-3 min-[1000px]:max-h-40 min-[1000px]:opacity-100" : "min-[1000px]:mt-0 min-[1000px]:max-h-0 min-[1000px]:opacity-0"} ${BODY_COLOR[variant]}`}
          >
            {body ?? step.fullBody ?? ""}
          </p>
        </div>
      </div>
    );
  })}
  </div>
</section>

<script>
  function initProcess() {
  document.querySelectorAll("[data-process-steps]").forEach((wrap) => {
    const expandable = wrap.hasAttribute("data-expandable");
    const section = wrap.closest("section");
    const counter = section ? section.querySelector("[data-process-count]") : null;
    const DARK = ["bg-ink", "text-white"];
    const WHITE = ["bg-white", "text-ink"];
    const LIGHT = ["bg-ink/[0.06]", "text-ink"];
    const BORDER_ON = ["border-ink"];
    const BORDER_OFF = ["border-ink/[0.08]"];
    const GROW_ON = ["min-[1000px]:grow-[2.3]"];
    const GROW_OFF = ["min-[1000px]:grow"];

    function paint(step, active) {
      step.classList.remove(...DARK, ...WHITE, ...LIGHT);
      step.classList.add(...(active ? DARK : WHITE));
      step.classList.remove(...BORDER_ON, ...BORDER_OFF);
      step.classList.add(...(active ? BORDER_ON : BORDER_OFF));
      if (expandable) {
        step.classList.remove(...GROW_ON, ...GROW_OFF);
        step.classList.add(...(active ? GROW_ON : GROW_OFF));
      }
      const meta = step.querySelector("[data-process-meta]");
      if (meta) {
        meta.classList.remove("text-white/70", "text-ink/70");
        meta.classList.add(active ? "text-white/70" : "text-ink/70");
      }
      const body = step.querySelector("[data-process-body]");
      if (body) {
        // Full copy lives in the node; visibility is class-driven so the
        // text can fade in/out like the reference. Base (mobile/tablet)
        // classes keep the body always visible — only the min-[1000px]:
        // (desktop row) variants collapse it for inactive cards.
        if (body.getAttribute("data-full") === null) {
          body.setAttribute("data-full", body.textContent ?? "");
        }
        body.textContent = body.getAttribute("data-full");
        body.classList.remove(
          "min-[1000px]:mt-3", "min-[1000px]:max-h-40", "min-[1000px]:opacity-100",
          "min-[1000px]:mt-0", "min-[1000px]:max-h-0", "min-[1000px]:opacity-0",
          "text-white/75", "text-ink/75"
        );
        body.classList.add(
          ...(active
            ? ["min-[1000px]:mt-3", "min-[1000px]:max-h-40", "min-[1000px]:opacity-100"]
            : ["min-[1000px]:mt-0", "min-[1000px]:max-h-0", "min-[1000px]:opacity-0"]),
          active ? "text-white/75" : "text-ink/75"
        );
      }
    }

    // Active card = hover override when present, else a continuous
    // scroll-progress index — matching the reference (LayerfolioProcess):
    // there's no touch/hover media-query branch at all, hover just wins
    // over the scroll-driven value when it's set. That's what makes
    // tablet/mobile (which never fires hover) track scroll position
    // instead of needing a tap.
    const getSteps = () => Array.from(wrap.querySelectorAll("[data-process-step]"));
    let hoverIndex = -1;
    let scrollIndex = 0;
    let rafId = 0;

    function computeScrollIndex() {
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight || 900;
      const raw = (vh - r.top) / (vh + r.height);
      const clamped = Math.min(1, Math.max(0, raw));
      // Remap the row's scroll-through-viewport progress from the window
      // [0.3, 0.72] to [0, 1] before mapping onto the step count — same
      // constants as the reference.
      const remapped = Math.min(1, Math.max(0, (clamped - 0.3) / (0.72 - 0.3)));
      const n = getSteps().length;
      return Math.min(n - 1, Math.max(0, Math.floor(remapped * n)));
    }

    function repaint() {
      const steps = getSteps();
      const active = hoverIndex >= 0 ? hoverIndex : scrollIndex;
      steps.forEach((s, i) => paint(s, i === active));
      if (counter) {
        const step = steps[active];
        if (step) counter.textContent = `Langkah ${Number(step.getAttribute("data-process-step"))} / ${steps.length}`;
      }
    }

    function onScrollOrResize() {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        rafId = 0;
        const next = computeScrollIndex();
        if (next !== scrollIndex) {
          scrollIndex = next;
          if (hoverIndex < 0) repaint();
        }
      });
    }

    let pending = 0;
    wrap.addEventListener("mouseover", (e) => {
      const step = e.target.closest ? e.target.closest("[data-process-step]") : null;
      if (!step || !wrap.contains(step)) return;
      const index = getSteps().indexOf(step);
      if (index === hoverIndex) return;
      // Hover intent: ignore fly-by crossings so fast sweeps don't flash
      // every intermediate card — only settle when the cursor rests.
      clearTimeout(pending);
      pending = setTimeout(() => {
        if (!wrap.contains(step) || !step.matches(":hover")) return;
        hoverIndex = index;
        repaint();
      }, 70);
    });
    // On mouseleave the active card reverts to whatever the scroll
    // position currently says, not to a fixed default — same as the
    // reference (hover is a temporary override on top of scroll).
    wrap.addEventListener("mouseleave", () => {
      clearTimeout(pending);
      hoverIndex = -1;
      repaint();
    });

    scrollIndex = computeScrollIndex();
    repaint();
    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize);
  });
  }

  // See Services.astro's initServices for why this needs `astro:page-load`
  // instead of running once at parse time.
  document.addEventListener("astro:page-load", initProcess);
</script>
