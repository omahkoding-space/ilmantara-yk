---
import GlyphIcon from "../GlyphIcon.astro";
import ArrowRow from "../ArrowRow.astro";

const FALLBACK_DOTS = ["#3B6FF5", "#FF5B24", "#10B37A", "#4B3BFF", "#1FB8A6", "#D4A72C"];

// Static content — CMS integration removed, edit directly here.
// Optional identity fields (photo, role, company, companyUrl, sourceUrl) render
// only when present; entries without verified data fall back to an initials
// avatar. Fabricate nothing — add real data as it becomes available.
type Testimonial = {
  quote: string;
  name: string;
  role?: string;
  company?: string;
  companyUrl?: string;
  /** Authorized client photo. When omitted, initials are shown instead. */
  photo?: string;
  /** Verified source of the review (e.g. a Google Business review link). */
  sourceUrl?: string;
  tag?: string;
  color?: string;
};

const testimonials: Testimonial[] = [
  {
    quote:
      "Kami butuh lebih dari sekadar tampilan baru. Toko barunya terasa lebih cepat, checkout-nya lebih mulus, dan kelola produk akhirnya jadi gampang.",
    name: "Ayu Lestari",
    role: "Pemilik, Toko Wellness",
    tag: "Shopify",
    color: "#FF5B24",
  },
  {
    quote:
      "Awalnya saya cuma punya ide, bingung cara mewujudkannya jadi produk yang jalan. Prosesnya jelas sejak hari pertama, dan hasil akhirnya persis seperti yang saya butuhkan.",
    name: "Misa K.",
    role: "Ilustrator Lepas",
    tag: "Aplikasi Web",
    color: "#10B37A",
  },
  {
    quote:
      "Aturan langganan kami makin rumit dikelola manual. Sekarang semuanya jalan lewat satu dashboard, hemat waktu dan minim kesalahan.",
    name: "Dimas Prasetyo",
    role: "Pendiri, Kopi Langganan",
    tag: "Laravel",
    color: "#A8562E",
  },
  {
    quote:
      "Kerja remote ternyata lebih mudah dari dugaan. Saya selalu tahu progresnya, dapat update rutin, dan bisa mereview sebelum tiap milestone besar.",
    name: "Jonas Weber",
    role: "Retail Online, Berlin",
    tag: "Shopify",
    color: "#4B3BFF",
  },
  {
    quote:
      "Enaknya punya satu developer yang paham tampilan sekaligus backend. Kami lebih sedikit menjelaskan, lebih banyak beres.",
    name: "Ratna Dewi",
    role: "Pemilik Butik, Jakarta",
    tag: "Full-stack",
    color: "#D4A72C",
  },
  {
    quote:
      "Kami butuh alat internal yang sesuai alur kerja, bukan spreadsheet lagi. Dashboard custom-nya menyatukan semuanya dan operasional harian jadi jauh lebih mudah.",
    name: "Andre Wijaya",
    role: "Pendiri Startup",
    tag: "Aplikasi Web",
    color: "#1FB8A6",
  },
];

const section = {
  heading: "Apa Kata Klien Kami",
  supportingText: "Cerita tentang proses, kolaborasi, dan apa yang kami bangun bersama.",
  ctaLabel: "Punya proyek?",
};

function initialsOf(name: string) {
  const parts = name.trim().split(/\s+/);
  return ((parts[0]?.[0] ?? "") + (parts[1]?.[0] ?? "")).toUpperCase() || "?";
}

// Pick black or white initials so the avatar label keeps a WCAG-safe contrast
// against its (per-testimonial) brand background colour.
function contrastText(hex: string): string {
  const c = hex.replace("#", "");
  const chan = (s: string) => {
    const v = parseInt(s, 16) / 255;
    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
  };
  const L = 0.2126 * chan(c.slice(0, 2)) + 0.7152 * chan(c.slice(2, 4)) + 0.0722 * chan(c.slice(4, 6));
  const white = 1.05 / (L + 0.05);
  const ink = (L + 0.05) / (0.003685 + 0.05);
  return ink >= white ? "#0C0C0E" : "#FFFFFF";
}
---

<section id="testimonials" data-framer-name="08 Testimonials" class="px-6 py-24 md:px-10 md:pb-48">
  <p class="font-mono text-xs font-medium tracking-wide">
    <span class="text-accent"># Ilmantara /</span> <span class="text-ink/65">Testimoni</span>
  </p>

  <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_320px]">
    <h2 class="text-[56px] font-bold leading-[1.05] tracking-[-0.03em] text-ink md:text-[64px]">
      {section.heading}
    </h2>
    <div>
      <p class="text-ink/70">{section.supportingText}</p>
      <ArrowRow href="/contact/" line="bottom" label={section.ctaLabel} />
    </div>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {testimonials.map((t, i) => (
      <div data-quote-reveal class="rounded-2xl border border-ink/[0.09] bg-white p-5 shadow-[0_22px_44px_-34px_rgba(12,12,14,0.5)] transition-all duration-500 hover:-translate-y-1 hover:border-ink/[0.16] hover:shadow-[0_34px_60px_-38px_rgba(12,12,14,0.6)]">
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-3">
            {t.photo ? (
              <img
                src={t.photo}
                alt={`Foto ${t.name}`}
                title={`Foto ${t.name}`}
                loading="lazy"
                class="h-8 w-8 shrink-0 rounded-full object-cover"
              />
            ) : (
              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold"
                style={`background-color: ${t.color || FALLBACK_DOTS[i % FALLBACK_DOTS.length]}; color: ${contrastText(t.color || FALLBACK_DOTS[i % FALLBACK_DOTS.length])};`}
                aria-hidden="true"
              >
                {initialsOf(t.name)}
              </div>
            )}
            <div>
              <p class="text-sm font-semibold text-ink">{t.name}</p>
              {(t.role || t.company) && (
                <p class="text-xs text-ink/65">
                  {t.role}{t.role && t.company ? ", " : ""}
                  {t.company && (t.companyUrl ? (
                    <a href={t.companyUrl} target="_blank" rel="noopener noreferrer" title={t.company} class="underline underline-offset-2 hover:text-accent">{t.company}</a>
                  ) : (
                    t.company
                  ))}
                </p>
              )}
            </div>
          </div>
          {t.tag && (
            <span class="flex shrink-0 items-center gap-1 whitespace-nowrap text-xs">
              <GlyphIcon name="diamond" class="text-ink/30" />
              <span class="text-accent">{t.tag}</span>
            </span>
          )}
        </div>

        <p class="mt-4 text-[15px] leading-snug text-ink/80">&ldquo;{t.quote}&rdquo;</p>

        {t.sourceUrl && (
          <a
            href={t.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            title="Sumber ulasan"
            class="mt-3 inline-flex items-center gap-1 text-xs text-ink/65 underline underline-offset-2 transition-colors hover:text-accent"
          >
            {"Sumber ulasan"}<GlyphIcon name="upRight" />
          </a>
        )}
      </div>
    ))}
  </div>
</section>

<script>
  // Scroll-linked reveal mirroring the reference quote grid: cards below the
  // fold sit blurred, resolving to sharp as they scroll into view. The
  // reference also faded opacity 0.35 → 1, but translucent text fails the
  // WCAG color-contrast audit for below-the-fold cards, so the fade is
  // dropped and only the blur animates. Purely progressive — no static change.
  function initTestimonials() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cards = Array.from(document.querySelectorAll("[data-quote-reveal]"));
    if (!cards.length || !("requestAnimationFrame" in window)) return;
    let ticking = false;

    function update() {
      ticking = false;
      const vh = window.innerHeight;
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        // 0 when the card top is a full viewport below the fold, 1 when the
        // card top reaches ~85% of the viewport height.
        const p = Math.min(1, Math.max(0, (vh * 0.98 - r.top) / (vh * 0.55)));
        const eased = p * p * (3 - 2 * p);
        const blur = (1 - eased) * 4;
        card.style.filter = blur < 0.05 ? "" : `blur(${blur.toFixed(2)}px)`;
      });
    }

    function kick() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener("scroll", kick, { passive: true });
    window.addEventListener("resize", kick);
  }

  // See Services.astro's initServices for why this needs `astro:page-load`
  // instead of running once at parse time.
  document.addEventListener("astro:page-load", initTestimonials);
</script>
