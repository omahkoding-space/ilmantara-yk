---
import ArrowRow from "../ArrowRow.astro";
import Img from "../Img.astro";
import { WORK } from "../../data/work";

const projects = WORK;

const ACCENTS = ["#4B3BFF", "#FF5B24", "#10B37A", "#9AE62B"];

const CASES = projects.map((p, i) => {
  const brand = p.name ?? p.title.split(" ").slice(0, 2).join(" ");
  return {
    tab: brand,
    eyebrow: [p.category, p.year].filter(Boolean).join(" · "),
    title: p.title,
    shortTitle: brand,
    summary: p.summary ?? "",
    tag: p.category ?? "Proyek",
    year: p.year ?? "",
    href: `/work/${p.slug}/`,
    img: p.cover ?? "/images/work/project-wellness.webp",
    imgAlt: p.coverAlt ?? p.title,
    accent: ACCENTS[i % ACCENTS.length],
  };
});

const sectionHeight = `calc(${CASES.length * 85 + 100}vh)`;
---

<section
  id="selected-work"
  data-framer-name="04 Selected work"
  class="relative bg-paper lg:[height:var(--work-h)]"
  style={`--work-h: ${sectionHeight};`}
>
  <div id="work-pin" class="relative lg:sticky lg:top-0 lg:h-screen lg:min-h-[560px] lg:overflow-hidden">
    <!-- dotted canvas + glow, like the reference -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(12,12,14,0.15) 1px, transparent 1.2px); background-size: 24px 24px;"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background: radial-gradient(900px 640px at 70% 55%, rgba(255,255,255,0.85), rgba(255,255,255,0) 70%);"
    ></div>

    <div class="relative mx-auto h-full w-full max-w-[1440px] px-5 pb-20 pt-16 md:px-8 lg:px-16 lg:pb-0 lg:pt-[92px]">
      <!-- header row -->
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="font-mono text-[11px] font-medium capitalize tracking-[0.05em] text-ink/65">
          <span class="text-accent"># Ilmantara /</span> Portofolio Website & Toko Online Shopify
        </h2>
        <div class="h-px flex-1 bg-ink/10"></div>
        <div class="flex flex-wrap gap-1.5">
          {CASES.map((c, i) => (
            <button
              type="button"
              data-work-tab={i}
              class={`rounded-md px-2.5 py-1.5 font-mono text-[11px] font-medium uppercase tracking-[0.05em] transition-colors duration-300 ${
                i === 0 ? "bg-ink text-white" : "bg-transparent text-ink/65 hover:text-ink"
              }`}
            >
              {String(i + 1).padStart(2, "0")} {c.tab}
            </button>
          ))}
        </div>
      </div>

      <div class="relative mt-8 lg:mt-10 lg:grid lg:h-[calc(100%-140px)] lg:grid-cols-[440px_minmax(0,1fr)] lg:items-start lg:gap-9">
        <div class="relative lg:h-full">
          {CASES.map((c, i) => (
            <article
              data-work-panel={i}
              class={`work-panel transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] lg:absolute lg:left-0 lg:top-0 lg:w-full ${
                i === 0 ? "lg:translate-y-0 lg:opacity-100 lg:blur-none" : "lg:pointer-events-none lg:translate-y-10 lg:opacity-0 lg:blur-[6px]"
              } ${i > 0 ? "mt-16 lg:mt-0" : ""}`}
            >
              <p class="flex gap-2.5 font-mono text-xs font-medium text-ink/65">
                <span>{c.tag}</span><span>·</span><span>{c.year}</span>
              </p>
              <h3 class="mt-4 text-balance text-[30px] font-semibold leading-[1.02] tracking-[-0.02em] text-ink lg:text-[44px]">
                {c.title}
              </h3>
              <p class="mt-2 max-w-[480px] text-[15px] leading-[1.55] text-ink/60">
                {c.summary}
              </p>

              <a
                href={c.href}
                title={c.title}
                class="group mt-6 block lg:hidden"
              >
                <div class="relative aspect-[8/5] overflow-hidden rounded-2xl">
                  <Img
                    src={c.img}
                    alt={c.imgAlt}
                    title={c.imgAlt}
                    sizes="(min-width: 1024px) 480px, 100vw"
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover object-top"
                  />
                </div>
                <p class="mt-3 text-[20px] font-semibold tracking-[-0.01em] text-ink">{c.title}</p>
              </a>

              <ArrowRow href={c.href} line="bottom" label="Lihat detail proyek" class="mt-7" />
            </article>
          ))}
        </div>

        <!-- Project image with About-style scroll reveal: full project
             image covered by a paper overlay (clip-path window frame)
             that opens as you scroll. No floating ornaments. -->
        <div class="hidden min-w-0 lg:block">
          <div class="relative ml-auto aspect-[16/10] w-full max-w-[760px] overflow-hidden bg-ink/5 shadow-[0_30px_70px_-30px_rgba(12,12,14,0.34)]">
            {CASES.map((c, i) => (
              <Img
                src={c.img}
                alt={c.imgAlt}
                title={c.imgAlt}
                draggable="false"
                data-work-hero={i}
                sizes="(min-width: 1024px) 760px, 100vw"
                class={`absolute inset-0 h-full w-full object-cover object-top transition-opacity duration-500 ease-out ${
                  i === 0 ? "opacity-100" : "opacity-0"
                }`}
              />
            ))}
            <!-- reveal overlay, same as the About image: paper window-frame
                 mask 16% → 0% + blue crop frame with thirds grid -->
            <div
              data-work-reveal
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 z-10"
              style="background: rgba(236,236,232,0.62); clip-path: polygon(0 0,100% 0,100% 100%,0 100%,0 16%,16% 16%,16% 84%,84% 84%,84% 16%,0 16%);"
            ></div>
            <!-- crop frame like About: blue border + dots at corners and
                 edge midpoints + thirds grid, tracks the overlay hole -->
            <div
              data-work-frame
              aria-hidden="true"
              class="pointer-events-none absolute z-20 border-[1.5px] border-accent"
              style="left: 16%; top: 16%; right: 16%; bottom: 16%;"
            >
              <span class="absolute left-0 top-0 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-1/2 top-0 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-full top-0 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-full top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-full top-full h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-1/2 top-full h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-0 top-full h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <span class="absolute left-0 top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
              <div data-work-grid aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.5)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.5)_1px,transparent_1px)] bg-size-[33.33%_33.33%]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initSelectedWork() {
  const section = document.getElementById("selected-work");
  const mq = window.matchMedia("(min-width: 1024px)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section) {
    const tabs = Array.from(section.querySelectorAll("[data-work-tab]"));
    const panels = Array.from(section.querySelectorAll("[data-work-panel]"));
    const heroes = Array.from(section.querySelectorAll("[data-work-hero]"));
    const revealOverlay = section.querySelector("[data-work-reveal]");
    const revealFrame = section.querySelector("[data-work-frame]");
    const revealGrid = section.querySelector("[data-work-grid]");
    const N = panels.length;
    let current = 0;

    // Reveal, same technique as the reference About image: a window-frame
    // overlay (clip-path "donut" polygon) whose border shrinks 16% → 0%
    // while the image eases scale 1.14 → 1 — driven by scroll progress
    // inside the active project's own segment, so it visibly opens
    // (melebar) on every project, not just the first.
    const clamp = (v, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));
    const remap = (v, lo, hi) => clamp((v - lo) / (hi - lo));
    const lerp = (a, b, t) => a + (b - a) * t;
    const easeOutQuart = (t) => 1 - (1 - t) ** 4;

    function setReveal(local) {
      const b = easeOutQuart(remap(local, 0.05, 0.7));
      const v = lerp(16, 0, b);
      if (revealOverlay instanceof HTMLElement) {
        revealOverlay.style.clipPath = `polygon(0 0,100% 0,100% 100%,0 100%,0 ${v}%,${v}% ${v}%,${v}% ${100 - v}%,${100 - v}% ${100 - v}%,${100 - v}% ${v}%,0 ${v}%)`;
        revealOverlay.style.opacity = v < 0.4 ? "0" : "1";
      }
      if (revealFrame instanceof HTMLElement) {
        revealFrame.style.left = `${v}%`;
        revealFrame.style.top = `${v}%`;
        revealFrame.style.right = `${v}%`;
        revealFrame.style.bottom = `${v}%`;
        revealFrame.style.opacity = String(1 - b);
      }
      if (revealGrid instanceof HTMLElement) revealGrid.style.opacity = String(1 - b);
      const activeHero = heroes[current];
      if (activeHero instanceof HTMLElement) {
        // Image eases scale 1.14 → 1 while sliding in from the right,
        // driven 1:1 by scroll (no CSS transition on transform).
        activeHero.style.transform = `translateX(${lerp(48, 0, b).toFixed(1)}px) scale(${lerp(1.14, 1, b).toFixed(3)})`;
      }
    }

    const BELOW = "lg:translate-y-10";
    const ABOVE = "lg:-translate-y-10";

    function showPanel(panel) {
      panel.classList.remove("lg:opacity-0", BELOW, ABOVE, "lg:blur-[6px]", "lg:pointer-events-none");
      panel.classList.add("lg:opacity-100", "lg:translate-y-0", "lg:blur-none");
    }

    function hidePanel(panel, exitCls) {
      panel.classList.remove("lg:opacity-100", "lg:translate-y-0", "lg:blur-none", BELOW, ABOVE);
      panel.classList.add("lg:opacity-0", exitCls, "lg:blur-[6px]", "lg:pointer-events-none");
    }

    function setActive(index) {
      const prev = current;
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle("bg-ink", on);
        tab.classList.toggle("text-white", on);
        tab.classList.toggle("bg-transparent", !on);
        tab.classList.toggle("text-ink/65", !on);
      });
      panels.forEach((panel, i) => {
        const on = i === index;
        if (reduceMotion || !mq.matches || prev === index) {
          // Instant state (first paint / reduced motion / mobile).
          if (on) showPanel(panel);
          else hidePanel(panel, BELOW);
          return;
        }
        if (on) {
          // Entering, like the reference: starts blurred + offset below
          // (scrolling forward) or above (scrolling back), then slides
          // into place.
          const from = index > prev ? BELOW : ABOVE;
          panel.classList.remove("lg:opacity-100", "lg:translate-y-0", "lg:blur-none", "lg:opacity-0", BELOW, ABOVE, "lg:blur-[6px]", "lg:pointer-events-none");
          panel.classList.add("lg:opacity-0", from, "lg:blur-[6px]", "lg:pointer-events-none");
          void panel.offsetWidth;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            if (current !== index || !mq.matches) return;
            showPanel(panel);
          }));
        } else {
          // Exiting: slides out upward (forward) / downward (back),
          // blurring away like the reference handoff.
          hidePanel(panel, index > prev ? ABOVE : BELOW);
        }
      });
      heroes.forEach((img, i) => {
        const on = i === index;
        img.classList.toggle("opacity-100", on);
        img.classList.toggle("opacity-0", !on);
        if (!on && img instanceof HTMLElement) img.style.transform = "";
      });
    }

    function measureScroll() {
      if (!mq.matches) return;
      const rect = section.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      if (total <= 0) return;
      const progress = Math.min(0.999, Math.max(0, -rect.top / total));
      const floating = progress * N;
      const index = Math.min(N - 1, Math.floor(floating));
      if (index !== current) setActive(index);
      setReveal(floating - index);
    }

    // Coalesce scroll bursts into one measure per frame — the panel swap and
    // reveal both read layout, so running per event janks on mobile.
    let scrollTick = 0;
    function onScroll() {
      if (scrollTick) return;
      scrollTick = requestAnimationFrame(() => { scrollTick = 0; measureScroll(); });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        if (!mq.matches || reduceMotion) {
          setActive(i);
          panels[i]?.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        const rect = section.getBoundingClientRect();
        const top = window.scrollY + rect.top;
        const total = rect.height - window.innerHeight;
        window.scrollTo({ top: top + ((i + 0.5) / N) * total, behavior: "smooth" });
      });
    });

    function openReveal() {
      if (revealOverlay instanceof HTMLElement) {
        revealOverlay.style.clipPath =
          "polygon(0 0,100% 0,100% 100%,0 100%,0 0%,0% 0%,0% 100%,100% 100%,100% 0%,0 0%)";
        revealOverlay.style.opacity = "0";
      }
      if (revealFrame instanceof HTMLElement) revealFrame.style.opacity = "0";
      if (revealGrid instanceof HTMLElement) revealGrid.style.opacity = "0";
      const hero = heroes[0];
      if (hero instanceof HTMLElement) hero.style.transform = "translateX(0px) scale(1)";
    }

    function onResize() {
      if (!mq.matches || reduceMotion) openReveal();
      else onScroll();
    }

    if (reduceMotion || !mq.matches) {
      setActive(0);
      onResize();
    } else {
      setActive(0);
      setReveal(0);
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize);
      onScroll();
    }
    mq.addEventListener?.("change", () => {
      if (mq.matches && !reduceMotion) {
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      } else {
        window.removeEventListener("scroll", onScroll);
        onResize();
      }
    });
  }
  }

  // See Services.astro's initServices for why this needs `astro:page-load`
  // instead of running once at parse time.
  document.addEventListener("astro:page-load", initSelectedWork);
</script>
