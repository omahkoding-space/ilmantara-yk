---
// Panah inline yang geser saat hover. Dipakai di dalam link yang sudah ada
// (<a> tidak boleh bersarang), jadi parent wajib punya class `group`.
import GlyphIcon from "./GlyphIcon.astro";
---
<span class="inline-block transition-transform duration-200 group-hover:translate-x-1"><GlyphIcon name="right" /></span>
