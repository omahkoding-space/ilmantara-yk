---
import GlyphIcon from "./GlyphIcon.astro";
// Shared custom hero for the homepage.
// Specification: research/hero-reference-20261012T095713Z/README.md.
import { WHATSAPP_LINK } from "../lib/site";
// Shared constants live in a module so the client script below is bundled and
// minified by Vite rather than emitted as unminified inline JS.
import { TEAM, ACCENT } from "../lib/hero-config";

const INK = "#0C0C0E";
const MARA_COLOR = "#FF5B24";

const HEADLINE = "Software House Jogja untuk Website, Toko Online Shopify & Aplikasi Web";
const DESCRIPTION = "Kami membantu UMKM dan brand membuat website, landing page, dan toko online Shopify yang cepat, mudah dikelola, dan siap mendatangkan pelanggan. Berbasis di Yogyakarta, melayani klien di seluruh Indonesia dan luar negeri.";
const TRUST_LINE = "Dipercaya pemilik brand, ilustrator, dan startup dari Jogja hingga Berlin · Shopify · Laravel · React";
const CURRENT_ROLE = "Software House Jogja";
const AVAILABILITY = "Menerima proyek baru";
const PRIMARY_LABEL = "Konsultasi Gratis via WhatsApp";
const PRIMARY_LINK = WHATSAPP_LINK;
const SECONDARY_LABEL = "Lihat Portofolio";
const SECONDARY_LINK = "/#selected-work";
const COMMENT_AUTHOR = "Dimas";
const COMMENT_TEXT = "Tulisannya bisa lebih besar? Ini yang pertama dibaca klien.";
const REPLY_AUTHOR = "Dana";
const REPLY_TEXT = "Sudah 208. Minta Tolong Di cek.";
const CHROME = "absolute rounded-xl border border-ink/10 bg-white/[.82] backdrop-blur-[14px] backdrop-saturate-[1.4] shadow-[inset_0_1px_0_rgba(255,255,255,.8),0_18px_40px_-18px_rgba(12,12,14,.28),0_2px_6px_rgba(12,12,14,.05)]";
const FIELD = "flex h-7 items-center gap-2 rounded-md bg-ink/[.045] px-2 font-mono text-[12px] font-medium leading-none transition-[background,color] duration-200";
---

<section data-hero-anim data-framer-name="01 Hero" class="relative">
  <div id="ha-container" class="relative -mt-14 h-screen min-h-[760px] min-[900px]:min-h-[560px] cursor-none overflow-hidden bg-paper font-sans text-[12px] text-ink select-none">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-90"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(12,12,14,0.16) 1px, transparent 1.2px); background-size: 24px 24px;"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: radial-gradient(1200px 520px at 50% 34%, rgba(255,255,255,0.75), transparent 70%);"
    >
    </div>

    <div id="ha-canvas" class="absolute left-0 top-0 origin-top-left">
      <div id="ha-artboard" class="absolute inset-0 origin-[50%_40%]">
      <div id="ha-statement" class="absolute text-center" style="opacity:0">
        <h1 id="ha-headline" class="m-0 mt-3 text-[26px] font-semibold leading-[1.16] tracking-[-0.032em] text-balance min-[900px]:text-[36px]">{HEADLINE}</h1>
        <p id="ha-description" class="mx-auto mb-0 mt-3 max-w-3xl text-[18px] font-normal leading-[1.45] tracking-[-0.015em] text-balance text-ink/60 min-[900px]:text-[20px]">{DESCRIPTION}</p>
        <p class="mx-auto mb-0 mt-3 max-w-3xl font-mono text-[11px] font-medium leading-[1.5] tracking-[0.02em] text-ink/65">{TRUST_LINE}</p>
      </div>
      <div
        id="ha-breadcrumb"
        class="absolute flex items-center gap-2.5 font-mono text-[11px] font-medium leading-none tracking-[0.02em]"
        style={`color: rgba(12,12,14,.5); opacity:0;`}
      >
        <span style={`color:${ACCENT}`}>#</span>
        <span>Home — <span id="ha-mode-label">Desktop</span></span>
        <span class="opacity-60" id="ha-dims-label">1440 × 900</span>
      </div>

      <div id="ha-role" data-floating-component="role" class="absolute w-[172px] will-change-transform transition-shadow duration-200 [@media(hover:hover)]:hover:shadow-[0_0_0_2px_#4B3BFF40] motion-reduce:transition-none min-[900px]:w-[208px]" style="opacity:0">
        <div class="absolute left-0 -top-[18px] flex items-center gap-1.5 font-mono text-[10px] font-medium leading-none whitespace-nowrap text-accent">
          <GlyphIcon name="diamond" /><span>Role</span>
        </div>
        <div class="rounded-[14px] border border-ink/10 bg-white p-[14px] shadow-[0_24px_44px_-22px_rgba(12,12,14,.42)]">
          <div class="flex items-center gap-[7px] font-mono text-[11px] font-medium uppercase tracking-[0.04em] whitespace-nowrap" style={`color:${ACCENT}`}>
            <GlyphIcon name="diamond" class="text-[10px] leading-none" />
            <span>{CURRENT_ROLE}</span>
          </div>
        </div>
      </div>
      <div id="ha-avail" data-floating-component="avail" class="absolute w-[206px] will-change-transform transition-shadow duration-200 [@media(hover:hover)]:hover:shadow-[0_0_0_2px_#4B3BFF40] motion-reduce:transition-none" style="opacity:0">
        <div class="absolute left-0 -top-[18px] flex items-center gap-1.5 font-mono text-[10px] font-medium leading-none whitespace-nowrap text-accent">
          <GlyphIcon name="diamond" /><span>Availability</span>
        </div>
        <div class="rounded-[14px] border border-ink/10 bg-white p-[14px] shadow-[0_24px_44px_-22px_rgba(12,12,14,.42)]">
          <div class="flex items-center gap-[7px] font-mono text-[11px] font-medium uppercase tracking-[0.04em] whitespace-nowrap" style="color: rgba(12,12,14,.62);">
            <span style="width:7px;height:7px;border-radius:9px;background:#19C37D;box-shadow:0 0 0 3px rgba(25,195,125,.18);"></span>
            <span>{AVAILABILITY}</span>
          </div>
        </div>
      </div>

      <svg id="ha-name-svg" class="pointer-events-none absolute left-0 top-0 overflow-visible" role="group" aria-label="Ilmantara move and resize controls">
        <g id="ha-glyph-scale" aria-hidden="true">
          <g id="ha-glyph-fill"></g>
          <g id="ha-glyph-outline"></g>
          <g id="ha-anchors"></g>
        </g>
        <g id="ha-selbox" aria-hidden="true">
          <rect id="ha-selrect" fill="none" stroke={ACCENT} stroke-width="1.5"></rect>
          <g id="ha-handles"></g>
        </g>
        <rect id="ha-move-surface" fill="transparent" class="pointer-events-none focus-visible:stroke-accent focus-visible:stroke-[2px]"></rect>
        <g id="ha-editor-hitareas"></g>
      </svg>
      <svg id="ha-hover-svg" class="pointer-events-none absolute left-0 top-0 z-[25] overflow-visible" aria-hidden="true">
        <g id="ha-hover-box" style="opacity:0"><rect fill="none" stroke={ACCENT} stroke-width="1.5"></rect></g>
        <g id="ha-guides"></g>
        <text id="ha-hover-label" class="font-mono text-[10px] font-medium" fill={ACCENT}></text>
      </svg>
      <div id="ha-dimlabel" class="pointer-events-none absolute origin-center rounded-[4px] bg-accent px-[7px] py-[5px] font-mono text-[11px] font-medium leading-none whitespace-nowrap text-white transition-[background] duration-200" style="opacity:0"></div>

      <div id="ha-cta" class="absolute left-0 flex flex-wrap justify-center gap-[10px]" style="opacity:0">
        <a href={PRIMARY_LINK} id="ha-cta-primary" title={PRIMARY_LABEL} target="_blank" rel="noopener" class="group box-border inline-flex h-12 cursor-none items-center gap-[10px] rounded-[10px] px-5 text-[15px] font-medium transition-[transform,box-shadow,background] duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] motion-safe:[@media(hover:hover)]:hover:-translate-y-0.5 hover:shadow-[0_14px_26px_-14px_rgba(12,12,14,.55)] active:translate-y-0 motion-safe:active:scale-[.98] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent" style={`background:${INK}; color:#fff; line-height:15px; letter-spacing:-0.015em;`}>
          {PRIMARY_LABEL}
          <svg class="transition-transform duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:translate-y-0.5 motion-reduce:transition-none" width="14" height="14" viewBox="0 0 14 14"><path d="M3 3 L11 11 M11 4.5 L11 11 L4.5 11" stroke="currentColor" stroke-width="1.6" fill="none"></path></svg>
        </a>
        <a href={SECONDARY_LINK} id="ha-cta-secondary" title={SECONDARY_LABEL} class="group box-border inline-flex h-12 cursor-none items-center gap-[10px] rounded-[10px] border border-ink/15 bg-white/[.7] px-5 text-[15px] font-medium text-ink backdrop-blur-[8px] transition-[transform,box-shadow,background] duration-[350ms] ease-[cubic-bezier(.22,1,.36,1)] motion-safe:[@media(hover:hover)]:hover:-translate-y-0.5 hover:shadow-[0_14px_26px_-14px_rgba(12,12,14,.35)] active:translate-y-0 motion-safe:active:scale-[.98] motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent" style="line-height:15px; letter-spacing:-0.015em;">
          {SECONDARY_LABEL}
        </a>
      </div>

      </div>
      <div id="ha-mara-cursor" class="pointer-events-none absolute z-30" style="opacity:0; will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" class="absolute -left-0.5 -top-0.5 drop-shadow-[0_2px_3px_rgba(0,0,0,.2)]">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill={MARA_COLOR} stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-ink shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${MARA_COLOR}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}>{COMMENT_AUTHOR}</div>
      </div>

      <!-- Avatar + collapsed-thread badge: the comment/reply card scales/fades
           out of this same anchor point as it collapses (K window). -->
      <div id="ha-comment-pulse" class="absolute size-8 rounded-full border-2 border-[#FF5B24] opacity-0" aria-hidden="true"></div>
      <div id="ha-thread-anchor" class="pointer-events-none absolute z-20" style="opacity:0;">
        <button type="button" id="ha-avatar" data-comment-toggle="mara" aria-label="Toggle Dimas comment" aria-controls="ha-comment" aria-expanded="false" disabled tabindex="-1" class="pointer-events-none cursor-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent absolute -left-[14px] -top-[30px] flex size-7 items-center justify-center rounded-[50%_50%_50%_4px] border-2 border-white bg-[#FF5B24] text-[12px] font-semibold leading-none text-ink shadow-[0_6px_14px_rgba(255,91,36,.35)]">
          {COMMENT_AUTHOR[0]}
          <span id="ha-thread-badge" class="absolute -right-[9px] -top-[7px] h-4 min-w-[16px] rounded-[9px] text-center text-[9px] font-semibold leading-4 text-white" style={`background:${INK};`}>2</span>
        </button>
        <div data-comment-popup id="ha-comment" class="absolute -left-[290px] -top-[6px] w-[262px] rounded-xl border border-ink/10 bg-white px-3 py-[11px] shadow-[0_22px_44px_-20px_rgba(12,12,14,.35)]">
          <div class="flex items-center gap-1.5 text-[12px] font-semibold leading-none">{COMMENT_AUTHOR}<span class="text-[11px] font-normal leading-none text-ink/65">just now</span></div>
          <div class="mt-1.5 min-h-[35px] text-[13px] font-normal leading-[1.35] tracking-[-0.01em]"><span id="ha-comment-text"></span><span id="ha-comment-caret" class="ml-px inline-block h-[14px] w-[1.5px] align-[-2px] bg-[#FF5B24]"></span></div>
          <div id="ha-reply-block" class="mt-[9px] border-t pt-[9px]" style="border-color: rgba(12,12,14,.1); opacity:0;">
            <div class="text-[12px] font-semibold leading-none text-[#10B37A]">{REPLY_AUTHOR}</div>
            <div class="mt-[5px] text-[13px]" style="line-height:1.35;">{REPLY_TEXT}</div>
          </div>
        </div>
      </div>

      <div id="ha-theo-cursor" class="pointer-events-none absolute z-30" style="opacity:0; will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" class="absolute -left-0.5 -top-0.5 drop-shadow-[0_2px_3px_rgba(0,0,0,.2)]">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill="#10B37A" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-ink shadow-[0_4px_10px_rgba(0,0,0,.12)]" style="left:14px; top:17px; background:#10B37A; padding:5px 7px; border-radius:3px 8px 8px 8px;">{REPLY_AUTHOR}</div>
      </div>

      {TEAM.map((member) => (
        <>
          <div id={`ha-${member.id}-cursor`} aria-hidden="true" class="pointer-events-none absolute z-30 opacity-0 will-change-transform">
            <svg width="20" height="22" viewBox="0 0 20 22" class="absolute -left-0.5 -top-0.5 drop-shadow-[0_2px_3px_rgba(0,0,0,.2)]">
              <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill={member.color} stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
            </svg>
            <div data-team-label class="absolute left-[14px] top-[17px] rounded-[3px_8px_8px_8px] px-[7px] py-[5px] text-[11px] font-medium leading-none tracking-[-0.01em] whitespace-nowrap shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={{ backgroundColor: member.color, color: member.labelColor }}>{member.name}</div>
          </div>
          {member.message && (
            <div id={`ha-${member.id}-thread`} aria-hidden="true" class="pointer-events-none absolute z-[28] opacity-0">
              <button type="button" data-team-avatar data-comment-toggle={member.id} aria-label={`Toggle ${member.name} comment`} aria-controls={`ha-${member.id}-bubble`} aria-expanded="false" disabled tabindex="-1" class="pointer-events-none cursor-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent absolute -right-[12px] -top-7 flex size-7 items-center justify-center rounded-[50%_50%_50%_4px] border-2 border-white text-[12px] font-semibold leading-none shadow-md" style={{ backgroundColor: member.color, color: member.labelColor }}>{member.name[0]}</button>
              <div id={`ha-${member.id}-bubble`} data-comment-popup data-team-bubble class="relative w-[260px] origin-top-right rounded-xl border border-ink/10 bg-white px-3 py-[11px] shadow-[0_22px_44px_-20px_rgba(12,12,14,.35)]">
                <div class="text-[12px] font-semibold leading-none" style={{ color: member.color }}>{member.name}</div>
                <div class="mt-1.5 text-[13px] leading-[1.35] tracking-[-0.01em]">{member.message}</div>
              </div>
            </div>
          )}
        </>
      ))}

      <div id="ha-pen-cursor" class="absolute pointer-events-none" style="opacity:0; z-index:30; will-change: transform;">
        <svg width="22" height="22" viewBox="0 0 22 22" style="position:absolute; left:-3px; top:-3px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.18));">
          <path d="M3 3 L9 17 L11.5 11.5 L17 9 Z" fill="#fff" stroke={ACCENT} stroke-width="1.6" stroke-linejoin="round"></path>
          <circle cx="10" cy="10" r="1.6" fill={ACCENT}></circle>
        </svg>
        <div id="ha-pen-cursor-label" class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${ACCENT}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}></div>
      </div>

      <div id="ha-you-cursor" class="pointer-events-none absolute z-30 hidden origin-top-left" style="will-change: transform;">
        <svg width="20" height="22" viewBox="0 0 20 22" style="position: absolute; left: -2px; top: -2px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.2));">
          <path d="M2.5 2.5 L2.5 18 L7 13.8 L10.2 20.4 L13 19.1 L9.9 12.6 L16 12.3 Z" fill={ACCENT} stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
        </svg>
        <div class="absolute whitespace-nowrap text-[11px] font-medium leading-none tracking-[-0.01em] text-white shadow-[0_4px_10px_rgba(0,0,0,.12)]" style={`left:14px; top:17px; background:${ACCENT}; padding:5px 7px; border-radius:3px 8px 8px 8px;`}>You</div>
      </div>

      <!-- These chrome panels use fixed CANVAS-space coordinates straight from
           the reference (left:36/top:590 and left:1168/top:548, desktop-only),
           not CSS bottom/right screen anchoring — so they pan/scale with the
           rest of the canvas instead of sticking to the viewport edge. -->
      <div id="ha-layers" data-floating-component="layers" style="opacity:0" class:list={[CHROME, "left-[36px] top-[590px] h-[262px] w-[236px] overflow-hidden text-[12px] leading-none will-change-transform transition-[border-color] duration-200 [@media(hover:hover)]:hover:border-accent/40 motion-reduce:transition-none"]}>
        <div class="flex gap-3.5 border-b border-ink/10 px-3.5 pt-3 pb-2.5 font-semibold">
          <span>Layers</span><span class="font-medium text-ink/65">Assets</span>
          <span class="ml-auto font-mono text-[10px] font-medium text-ink/65">Home</span>
        </div>
        <div id="ha-layers-list" class="p-1.5"></div>
      </div>

      <div id="ha-inspect" data-floating-component="inspect" style="opacity:0" class:list={[CHROME, "left-[1168px] top-[548px] h-[304px] w-[236px] overflow-hidden will-change-transform transition-[border-color] duration-200 [@media(hover:hover)]:hover:border-accent/40 motion-reduce:transition-none"]}>
        <div class="flex gap-3.5 border-b border-ink/10 px-3.5 pt-3 pb-2.5 text-[12px] font-semibold leading-none"><span>Design</span><span class="font-medium text-ink/65">Prototype</span><span class="font-medium text-ink/65">Inspect</span></div>
        <div class="grid gap-3.5 px-3.5 py-3">
          <div>
            <div id="ha-inspect-name" class="mb-[9px] overflow-hidden text-[11px] font-semibold leading-none text-ink/80 text-ellipsis whitespace-nowrap">Nothing selected</div>
            <div class="grid grid-cols-2 gap-1.5">
              <div class={FIELD}><span class="text-[10px] text-ink/65">X</span><span id="ha-inspect-x">–</span></div>
              <div class={FIELD}><span class="text-[10px] text-ink/65">Y</span><span id="ha-inspect-y">–</span></div>
              <div id="ha-field-w" class={FIELD}><span class="text-[10px] text-ink/65">W</span><span id="ha-inspect-w">–</span></div>
              <div id="ha-field-h" class={FIELD}><span class="text-[10px] text-ink/65">H</span><span id="ha-inspect-h">–</span></div>
            </div>
          </div>
          <div id="ha-inspect-text-block">
            <div class="mb-[9px] text-[11px] font-semibold leading-none text-ink/80">Text</div>
            <div class="flex justify-between text-[12px] font-medium leading-none"><span>Geist</span><span class="text-ink/65">Semibold</span></div>
            <div class="mt-2 grid grid-cols-2 gap-1.5">
              <div id="ha-field-font" class={FIELD}><span class="text-[10px] text-ink/65">Aa</span><span id="ha-inspect-fontsize">200</span></div>
              <div class={FIELD}><span class="text-[10px] text-ink/65">|A|</span>-5%</div>
            </div>
          </div>
          <div>
            <div class="mb-[9px] text-[11px] font-semibold leading-none text-ink/80">Fill</div>
            <div class="flex items-center gap-2 font-mono text-[12px] font-medium leading-none">
              <span id="ha-inspect-swatch" class="size-4 shrink-0 rounded-[4px] border border-ink/10 bg-ink bg-cover"></span>
              <span id="ha-inspect-fill">RGB(12, 12, 14)</span>
              <span id="ha-inspect-fill-detail" class="ml-auto text-ink/65">100%</span>
            </div>
          </div>
        </div>
      </div>

      <div id="ha-toolbar" style="opacity:0" class:list={[CHROME, "left-[570px] top-[842px] flex h-11 w-[300px] items-center justify-center gap-1 overflow-visible"]}>
        <button id="ha-tool-move" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Move">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 2 L3 13 L6.2 10 L8.5 14.5 L10.4 13.6 L8.2 9.2 L12.5 9 Z"></path></svg>
        </button>
        <button id="ha-tool-frame" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Frame">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M5 1.5v13M11 1.5v13M1.5 5h13M1.5 11h13"></path></svg>
        </button>
        <button id="ha-tool-pen" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Pen">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 13 L5 7 L9.5 2.5 L13.5 6.5 L9 11 Z M3 13 L7 9"></path><circle cx="7.4" cy="8.6" r="1"></circle></svg>
        </button>
        <button id="ha-tool-text" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Text">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M3 3.5h10M8 3.5v10M6 13.5h4"></path></svg>
        </button>
        <button id="ha-tool-comment" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Comment">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M8 2.5a5.5 5.5 0 1 1-4.3 8.9L2.5 13.5l.6-3A5.5 5.5 0 0 1 8 2.5z"></path></svg>
        </button>
        <button id="ha-tool-scale" class="flex h-8 w-9 items-center justify-center rounded-lg" aria-label="Scale">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0C0C0E" stroke-width="1.4" stroke-linejoin="round"><path d="M2.5 13.5h4M2.5 13.5v-4M13.5 2.5h-4M13.5 2.5v4M3 13l10-10"></path></svg>
        </button>
        <span class="mx-1.5 h-5 w-px" style="background: rgba(12,12,14,.1);"></span>
        <span class="font-mono text-[11px] font-medium leading-none text-ink/65">100%</span>
      </div>
    </div>

    <div id="ha-ruler" class="pointer-events-none absolute inset-0" style="opacity:0;">
      <svg id="ha-ruler-h" style="position:absolute; left:0; top:0; background: rgba(248,248,246,.92); border-bottom:1px solid rgba(12,12,14,.1);"></svg>
      <svg id="ha-ruler-v" style="position:absolute; left:0; top:20px; background: rgba(248,248,246,.92); border-right:1px solid rgba(12,12,14,.1);"></svg>
      <div id="ha-ruler-corner" style="position:absolute; left:0; top:0; width:20px; height:20px; background:rgb(248,248,246); border-right:1px solid rgba(12,12,14,.1); border-bottom:1px solid rgba(12,12,14,.1);"></div>
    </div>
  </div>
</section>

<script>
  import glyphData from "../data/hero-glyphs.json";
  import { createWordmarkEditor, paintActionCursor } from "../lib/hero-wordmark-editor.js";
  import { CANVAS_W, CANVAS_H, MOBILE_CANVAS_W, MOBILE_CANVAS_H, ORIGINAL_DURATION, TOTAL_DURATION, TEAM, ACCENT, GUIDE_COLOR, COMMENT_TEXT } from "../lib/hero-config";

  const EASE = {
    out: (e) => 1 - (1 - e) ** 4,
    expo: (e) => (e >= 1 ? 1 : 1 - 2 ** (-10 * e)),
    inOut: (e) => (e < 0.5 ? 8 * e * e * e * e : 1 - (-2 * e + 2) ** 4 / 2),
    back: (e) => 1 + 2.56 * (e - 1) ** 3 + 1.56 * (e - 1) ** 2,
  };
  const clamp = (v, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));
  const norm = (v, a, b) => clamp((v - a) / (b - a));
  const lerp = (a, b, t) => a + (b - a) * t;
  const round = (n) => Math.round(n);
  const NS = "http://www.w3.org/2000/svg";
  function setText(node, value) {
    const text = String(value);
    if (node.textContent !== text) node.textContent = text;
  }

  // Secondary-story beats are hardcoded absolute seconds in the reference,
  // calibrated for "Ilmantara" (9 glyphs, L_ref=3.15s). Expressed here as
  // offsets from L_ref so the rhythm scales with however many glyphs our text has.
  const L_REF = 3.15;
  const off = (abs) => abs - L_REF;
  const BEATS = {
    commentPulseStart: off(4.95), commentPulseEnd: off(5.25),
    commentScaleStart: off(5.05), commentScaleEnd: off(5.45),
    typeStart: off(5.3), typeEnd: off(6.4),
    toolCommentStart: off(4.7), toolCommentEnd: off(5.4),
    toolScaleStart: off(7.3), toolScaleEnd: off(8.6),
    maraArriveStart: off(3.9), maraArriveEnd: off(5.0),
    maraDepartStart: off(6.4), maraDepartEnd: off(7.4),
    wobbleBase: off(6.4),
    secondApproachStart: off(6.3), secondApproachEnd: off(7.35),
    scaleBumpStart: off(7.5), scaleBumpEnd: off(8.5),
    replyBackStart: off(8.7), replyBackEnd: off(9.1),
    secondToFtStart: off(8.8), secondToFtEnd: off(9.7),
    secondArcStart: off(9.7), secondArcEnd: off(11.5),
    secondFinalStart: off(11.5), secondFinalEnd: off(12.4),
    collapseStart: off(10.4), collapseEnd: off(10.9),
  };

  async function init() {
    const container = document.getElementById("ha-container");
    const canvas = document.getElementById("ha-canvas");
    if (!container || !canvas || container.dataset.haInitialized) return;
    container.dataset.haInitialized = "true";
    const artboard = document.getElementById("ha-artboard");
    const abort = new AbortController();

    const svg = document.getElementById("ha-name-svg");
    const hoverSvg = document.getElementById("ha-hover-svg");
    const glyphScaleG = document.getElementById("ha-glyph-scale");
    const glyphFillG = document.getElementById("ha-glyph-fill");
    const glyphOutlineG = document.getElementById("ha-glyph-outline");
    const anchorsG = document.getElementById("ha-anchors");
    const selRect = document.getElementById("ha-selrect");
    const selBoxG = document.getElementById("ha-selbox");
    const handlesG = document.getElementById("ha-handles");
    const hoverBoxG = document.getElementById("ha-hover-box");
    const hoverRect = hoverBoxG.querySelector("rect");
    const guidesG = document.getElementById("ha-guides");
    const dimLabel = document.getElementById("ha-dimlabel");
    const hoverLabel = document.getElementById("ha-hover-label");
    const breadcrumb = document.getElementById("ha-breadcrumb");
    const modeLabel = document.getElementById("ha-mode-label");
    const dimsLabel = document.getElementById("ha-dims-label");
    const roleEl = document.getElementById("ha-role");
    const availEl = document.getElementById("ha-avail");
    const statement = document.getElementById("ha-statement");
    const contentLayout = { key: null, height: 0, ctaHeight: 48, ctaWidth: 194, roleHeight: 0, availHeight: 0 };
    const cta = document.getElementById("ha-cta");
    const ctaPrimary = document.getElementById("ha-cta-primary");
    const maraCursor = document.getElementById("ha-mara-cursor");
    const commentCaret = document.getElementById("ha-comment-caret");
    const commentPulse = document.getElementById("ha-comment-pulse");
    const threadAnchor = document.getElementById("ha-thread-anchor");
    artboard.append(threadAnchor, commentPulse);
    const avatar = document.getElementById("ha-avatar");
    const threadBadge = document.getElementById("ha-thread-badge");
    const comment = document.getElementById("ha-comment");
    const commentText = document.getElementById("ha-comment-text");
    const replyBlock = document.getElementById("ha-reply-block");
    const theoCursor = document.getElementById("ha-theo-cursor");
    const penCursor = document.getElementById("ha-pen-cursor");
    document.getElementById("ha-pen-cursor-label").textContent = `${glyphData.text.split(" ")[0]} · Pen`;
    const youCursor = document.getElementById("ha-you-cursor");
    const hRulerSvg = document.getElementById("ha-ruler-h");
    const vRulerSvg = document.getElementById("ha-ruler-v");
    const rulerCorner = document.getElementById("ha-ruler-corner");
    const RULER_TICK = "rgba(12,12,14,.28)";
    const RULER_LABEL = "rgba(12,12,14,.45)";
    function svgEl(tag, attrs) {
      const node = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      return node;
    }
    // Canvas-anchored ruler (ported from the reference's own `ht()`): ticks
    // are drawn in CANVAS space and panned/scaled by originX/originY/s, same
    // as the name/selection box — not static screen pixels.
    let hSelection, vSelection;
    function drawRuler(w, h, originX, originY, s) {
      hRulerSvg.setAttribute("width", String(w));
      hRulerSvg.setAttribute("height", "20");
      hRulerSvg.style.top = "56px";
      vRulerSvg.setAttribute("width", "20");
      vRulerSvg.setAttribute("height", String(Math.max(0, h - 56 - 20)));
      vRulerSvg.style.top = "76px";
      rulerCorner.style.top = "56px";
      hRulerSvg.replaceChildren();
      vRulerSvg.replaceChildren();
      hSelection = svgEl("rect", { y: 0, height: 20, fill: ACCENT, opacity: .14 });
      vSelection = svgEl("rect", { x: 0, width: 20, fill: ACCENT, opacity: .14 });
      hRulerSvg.appendChild(hSelection);
      vRulerSvg.appendChild(vSelection);

      const hStart = Math.floor((20 - originX) / s / 10) * 10;
      const hEnd = (w - originX) / s;
      for (let cx = hStart; cx <= hEnd; cx += 10) {
        const sx = originX + cx * s;
        if (sx < 20) continue;
        const major = cx % 100 === 0;
        hRulerSvg.appendChild(svgEl("line", { x1: sx, x2: sx, y1: major ? 6 : cx % 50 === 0 ? 12 : 15, y2: 20, stroke: RULER_TICK, "stroke-width": 1 }));
        if (major) {
          const t = svgEl("text", { x: sx + 3, y: 10, fill: RULER_LABEL, "font-family": "'Geist Mono', monospace", "font-size": 8.5 });
          t.textContent = String(cx);
          hRulerSvg.appendChild(t);
        }
      }

      const vStart = Math.floor((76 - originY) / s / 10) * 10;
      const vEnd = (h - originY) / s;
      for (let cy = vStart; cy <= vEnd; cy += 10) {
        const sy = originY + cy * s - 56 - 20;
        if (sy < 0) continue;
        const major = cy % 100 === 0;
        vRulerSvg.appendChild(svgEl("line", { y1: sy, y2: sy, x1: major ? 6 : cy % 50 === 0 ? 12 : 15, x2: 20, stroke: RULER_TICK, "stroke-width": 1 }));
        if (major) {
          const t = svgEl("text", {
            x: 10, y: sy + 3, fill: RULER_LABEL, "font-family": "'Geist Mono', monospace", "font-size": 8.5,
            transform: `rotate(-90 10 ${sy + 3})`,
          });
          t.textContent = String(cy);
          vRulerSvg.appendChild(t);
        }
      }
    }
    let hCrosshair = null, vCrosshair = null;
    let lastCrosshairKey = null;
    let lastRulerKey = null; // only rebuild the ~140-node tick/label DOM when geometry actually changes, not every RAF frame
    const parallax = { x: 0, y: 0 }; // panel parallax, independent of the wordmark editor
    function updateRulerCrosshair(mouse) {
      const key = mouse ? `${mouse.x}|${mouse.y}` : 'none';
      if (key === lastCrosshairKey && (!mouse || hCrosshair?.isConnected)) return;
      lastCrosshairKey = key;
      if (!hCrosshair?.isConnected) {
        hCrosshair = svgEl('line', { y1: 0, y2: 20, stroke: ACCENT, 'stroke-width': 1.5 });
        vCrosshair = svgEl('line', { x1: 0, x2: 20, stroke: ACCENT, 'stroke-width': 1.5 });
        hRulerSvg.append(hCrosshair); vRulerSvg.append(vCrosshair);
      }
      hCrosshair.style.display = vCrosshair.style.display = mouse ? '' : 'none';
      if (!mouse) return;
      hCrosshair.setAttribute('x1', mouse.x); hCrosshair.setAttribute('x2', mouse.x);
      vCrosshair.setAttribute('y1', mouse.y - 76); vCrosshair.setAttribute('y2', mouse.y - 76);
    }
    const layersList = document.getElementById("ha-layers-list");
    const layersPanel = document.getElementById("ha-layers");
    const inspectPanel = document.getElementById("ha-inspect");
    const inspectName = document.getElementById("ha-inspect-name");
    const inspectX = document.getElementById("ha-inspect-x");
    const inspectY = document.getElementById("ha-inspect-y");
    const inspectW = document.getElementById("ha-inspect-w");
    const inspectH = document.getElementById("ha-inspect-h");
    const inspectTextBlock = document.getElementById("ha-inspect-text-block");
    const inspectFontSize = document.getElementById("ha-inspect-fontsize");
    const toolMove = document.getElementById("ha-tool-move");
    const toolFrame = document.getElementById("ha-tool-frame");
    const toolPen = document.getElementById("ha-tool-pen");
    const toolText = document.getElementById("ha-tool-text");
    const toolComment = document.getElementById("ha-tool-comment");
    const toolScale = document.getElementById("ha-tool-scale");
    const toolButtons = { move: toolMove, frame: toolFrame, pen: toolPen, text: toolText, comment: toolComment, scale: toolScale };
    const toolbar = document.getElementById("ha-toolbar");
    const floating = Object.fromEntries([["role", roleEl, 10], ["avail", availEl, 16], ["layers", layersPanel, 5], ["inspect", inspectPanel, 5]].map(([id, node, depth], index) => {
      const state = { node, depth, index, hovered: false, lift: 0, x: 0, y: 0 };
      node.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') state.hovered = true; }, { signal: abort.signal });
      node.addEventListener('pointerleave', () => { state.hovered = false; }, { signal: abort.signal });
      return [id, state];
    }));
    let lastMotionTick = performance.now();
    let lastPanelState = null;
    let lastTool = null;
    const layerRowIcons = {};
    const teamNodes = TEAM.map((member) => ({
      ...member,
      cursor: document.getElementById(`ha-${member.id}-cursor`),
      thread: document.getElementById(`ha-${member.id}-thread`),
    }));

    // --- Build glyph DOM once (fill path + dashed outline path + anchor markers per glyph) ---
    const glyphNodes = glyphData.glyphs.map((g) => {
      const fillPath = document.createElementNS(NS, "path");
      fillPath.setAttribute("d", g.d);
      fillPath.setAttribute("fill", "#0C0C0E");
      fillPath.setAttribute("stroke", "none");
      glyphFillG.appendChild(fillPath);

      const outlinePath = document.createElementNS(NS, "path");
      outlinePath.setAttribute("d", g.d);
      outlinePath.setAttribute("fill", "none");
      outlinePath.setAttribute("stroke", ACCENT);
      outlinePath.setAttribute("stroke-dasharray", "1 1");
      outlinePath.setAttribute("pathLength", "1");
      glyphOutlineG.appendChild(outlinePath);

      const glyphAnchorG = svgEl("g", {});
      anchorsG.appendChild(glyphAnchorG);
      const onCurve = g.pts.filter((p) => p[2] === 0);
      const anchorNodes = onCurve.map(() => {
        const r = document.createElementNS(NS, "rect");
        r.setAttribute("width", 5);
        r.setAttribute("height", 5);
        r.setAttribute("fill", "#fff");
        r.setAttribute("stroke", ACCENT);
        r.setAttribute("stroke-width", 1);
        glyphAnchorG.appendChild(r);
        return r;
      });

      const controls = g.pts.filter((p) => p[2] === 1).map((p) => {
        const nodes = [svgEl("line", { stroke: ACCENT, "stroke-width": .8, opacity: .7 }), svgEl("line", { stroke: ACCENT, "stroke-width": .8, opacity: .7 }), svgEl("circle", { r: 2.6, fill: "#fff", stroke: ACCENT, "stroke-width": 1 })];
        const group = svgEl("g", {});
        group.append(...nodes);
        glyphAnchorG.insertBefore(group, anchorNodes[0] || null);
        return { p, nodes, group };
      });
      return { glyph: g, fillPath, outlinePath, onCurve, anchorNodes, controls };
    });

    const HANDLE_POS = [
      [0, 0], [0.5, 0], [1, 0], [1, 0.5], [1, 1], [0.5, 1], [0, 1], [0, 0.5],
    ];
    const handleNodes = HANDLE_POS.map(() => {
      const r = document.createElementNS(NS, "rect");
      r.setAttribute("fill", "#fff");
      r.setAttribute("stroke", ACCENT);
      r.setAttribute("stroke-width", 1.5);
      handlesG.appendChild(r);
      return r;
    });

    const layerIcons = {
      frame: '<path d="M3.5 1v10M8.5 1v10M1 3.5h10M1 8.5h10" stroke-width="1.2"/>',
      name: '<path d="M2 10 C3 4 9 8 10 2" stroke-width="1.2"/><rect x=".8" y="8.8" width="2.4" height="2.4" fill="currentColor" stroke="none"/><rect x="8.8" y=".8" width="2.4" height="2.4" fill="currentColor" stroke="none"/>',
      statement: '<path d="M2 2.5h8M6 2.5v8" stroke-width="1.3"/>',
      cta: '<path d="M6 .8 L11.2 6 L6 11.2 L.8 6 Z" stroke-width="1.2"/>',
      role: '<path d="M6 .8 L11.2 6 L6 11.2 L.8 6 Z" stroke-width="1.2"/>',
      avail: '<circle cx="6" cy="6" r="3" stroke-width="1.2"/>',
      comment: '<path d="M2 2h8v6H5l-3 2.5z" stroke-width="1.2" stroke-linejoin="round"/>',
    };
    const LAYER_DEFS = [
      { id: "frame", label: "Home — Desktop", depth: 0 },
      { id: "name", label: glyphData.text, depth: 1 },
      { id: "statement", label: "Statement", depth: 1 },
      { id: "cta", label: "Buttons", depth: 1 },
      { id: "role", label: "Role", depth: 1 },
      { id: "avail", label: "Availability", depth: 1 },
      { id: "comment", label: "Comment · Dimas", depth: 1 },
    ];
    const layerRows = {};
    LAYER_DEFS.forEach((def) => {
      const row = document.createElement("div");
      row.className = `flex h-[29px] items-center gap-2 overflow-hidden rounded-md text-[12px] leading-none tracking-[-0.01em] whitespace-nowrap transition-[background,color] duration-[250ms] ${def.depth === 0 ? "font-semibold" : "font-medium"}`;
      row.style.padding = `0 8px 0 ${8 + def.depth * 16}px`;
      row.innerHTML = `<svg class="shrink-0" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor">${layerIcons[def.id]}</svg><span class="overflow-hidden text-ellipsis">${def.label}</span>`;
      layersList.appendChild(row);
      layerRows[def.id] = row;
      layerRowIcons[def.id] = row.querySelector('svg');
    });

    // --- State ---
    let scale = 1;
    let size = { width: CANVAS_W, height: CANVAS_H };
    let mouseScreen = null; // {x,y} in container-local screen px
    let debugScroll = null;
    let debugTime = null; // set via window.__ilmantaraHero.render() for deterministic snapshots
    let lastGlyphLayoutKey = null;
    let lastGuideKey = null;
    const guidePool = []; // Reuse at most20 SVG nodes, including animated hover guides.
    let lastSvgSizeKey = null;
    // Match the reference: offset the clock reference itself (rather than
    // special-casing a "skip to end" branch) so a reduced-motion visitor's
    // very first frame already reads D≈TOTAL_DURATION (settled) and the
    // normal RAF loop just continues from there.
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let prefersReducedMotion = motionQuery.matches;
    let startTime = performance.now() - (prefersReducedMotion ? TOTAL_DURATION * 1000 : 0);
    let rafId = 0;
    let lastTime = prefersReducedMotion ? TOTAL_DURATION : 0;
    let visible = true;
    const visibility = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; render(lastTime); requestFrame(); });
    visibility.observe(container);
    const editor = createWordmarkEditor({
      container, svg, surface: document.getElementById("ha-move-surface"),
      hitGroup: document.getElementById("ha-editor-hitareas"), youCursor,
      onChange: () => { render(lastTime); requestFrame(); }, signal: abort.signal,
    });
    let openThread = null;
    const commentControls = [
      { id: 'mara', button: avatar, popup: comment },
      ...teamNodes.filter(member => member.thread).map(member => ({ id: member.id, button: member.thread.querySelector('[data-team-avatar]'), popup: member.thread.querySelector('[data-team-bubble]') })),
    ];
    for (const control of commentControls) {
      control.popup.setAttribute('role', 'region');
      control.popup.setAttribute('aria-label', `${control.id} comment`);
      control.button.addEventListener('click', () => {
        if (lastTime < TOTAL_DURATION) return;
        openThread = openThread === control.id ? null : control.id;
        render(lastTime);
      }, { signal: abort.signal });
    }
    document.addEventListener('pointerdown', event => {
      if (openThread && !commentControls.some(control => control.button.contains(event.target) || control.popup.contains(event.target))) {
        openThread = null; render(lastTime);
      }
    }, { signal: abort.signal });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && openThread) {
        const control = commentControls.find(control => control.id === openThread);
        openThread = null; render(lastTime); control.button.focus();
      }
    }, { signal: abort.signal });

    motionQuery.addEventListener("change", () => {
      prefersReducedMotion = motionQuery.matches;
      if (prefersReducedMotion && lastTime < TOTAL_DURATION) {
        startTime = performance.now() - TOTAL_DURATION * 1000;
        lastTime = TOTAL_DURATION;
      }
      render(lastTime); requestFrame();
    }, { signal: abort.signal });

    function canvasToScreen(x, y, origin, s) {
      return { x: origin.x + x * s, y: origin.y + y * s };
    }

    function render(D) {
      lastTime = D;
      const bounds = container.getBoundingClientRect();
      const scroll = prefersReducedMotion ? 0 : debugScroll === null ? clamp(-bounds.top / Math.max(1, bounds.height)) : debugScroll;
      const q = EASE.out(scroll);
      const nameOffset = -scroll * 50;
      artboard.style.transform = `translateY(${-scroll * 30}px) scale(${1 - q * .1})`;
      svg.style.top = `${nameOffset}px`;
      const w = container.clientWidth || CANVAS_W;
      const h = container.clientHeight || CANVAS_H;
      const mobile = w < 900;
      const k = mobile ? MOBILE_CANVAS_W : CANVAS_W;
      const A = mobile ? MOBILE_CANVAS_H : CANVAS_H;
      const headerH = 56;
      const innerH = h - headerH;
      const s = mobile
        ? Math.min(w / k, Math.max(0.5, h / A))
        : Math.min(w / CANVAS_W, Math.max(0.3, h / CANVAS_H));
      const originX = (w - k * s) / 2;
      const originY = headerH + Math.max(0, (innerH - (A - headerH) * s) / 2) - headerH * s;

      canvas.style.transform = `scale(${s})`;
      canvas.style.width = `${k}px`;
      canvas.style.height = `${A}px`;
      canvas.style.left = `${originX}px`;
      canvas.style.top = `${originY}px`;
      const svgSizeKey = `${k}|${A}`;
      if (svgSizeKey !== lastSvgSizeKey) {
        svg.setAttribute("width", k);
        svg.setAttribute("height", A);
        svg.setAttribute("viewBox", `0 0 ${k} ${A}`);
        hoverSvg.setAttribute("width", k); hoverSvg.setAttribute("height", A);
        lastSvgSizeKey = svgSizeKey;
      }

      const rulerKey = `${w}x${h}x${Math.round(originX * 100)}x${Math.round(originY * 100)}x${Math.round(s * 10000)}`;
      if (rulerKey !== lastRulerKey) {
        drawRuler(w, h, originX, originY, s);
        lastRulerKey = rulerKey;
      }
      updateRulerCrosshair(mouseScreen);

      setText(modeLabel, mobile ? "Phone" : "Desktop");
      setText(dimsLabel, mobile ? "390 × 844" : "1440 × 900");
      breadcrumb.style.left = `${mobile ? 20 : 44}px`;
      breadcrumb.style.top = "84px";
      const breadcrumbOpacity = EASE.out(norm(D, 0, 0.5));
      breadcrumb.style.opacity = breadcrumbOpacity;

      // --- Glyph layout (row-wrap only matters if the text contains a space on mobile) ---
      const glyphs = glyphData.glyphs;
      const chars = Array.from(glyphData.text);
      const rowOf = [];
      {
        let row = 0, n = 0;
        for (let i = 0; i < chars.length && n < glyphs.length; i++) {
          if (chars[i] === " ") { if (mobile) row++; continue; }
          if (glyphs[n] && glyphs[n].ch === chars[i]) { rowOf[n] = row; n++; }
        }
        for (; n < glyphs.length; n++) rowOf[n] = row;
      }
      const rowMin = [], rowMax = [];
      glyphs.forEach((g, i) => {
        const r = rowOf[i];
        rowMin[r] = Math.min(rowMin[r] ?? Infinity, g.x);
        rowMax[r] = Math.max(rowMax[r] ?? -Infinity, g.x + g.w);
      });
      const rowWidths = rowMin.map((m, i) => rowMax[i] - m);
      const maxRowWidth = Math.max(1, ...rowWidths);
      const numRows = rowMin.length;

      const fontPx = mobile ? Math.min(124, (350 * 1000) / maxRowWidth) : 200;
      const j = fontPx / 1000;
      const rowHeight = glyphData.cap * j + fontPx * 0.2;
      const glyphOffX = glyphs.map((g, i) => -rowMin[rowOf[i]] + (maxRowWidth - rowWidths[rowOf[i]]) / 2);
      const glyphOffY = glyphs.map((g, i) => rowOf[i] * rowHeight);

      const Ye = glyphs.length;
      const startDelay = 0.35;
      const stagger = Math.min(0.17, 1.9 / Math.max(1, Ye));
      const drawDuration = 0.75;
      const traceEnd = startDelay + stagger * (Ye - 1) + drawDuration;
      const fillStart = traceEnd - 0.35;
      const L = traceEnd + 0.35;

      const M = lerp(1, 1.04, EASE.inOut(norm(D, L + BEATS.scaleBumpStart, L + BEATS.scaleBumpEnd)));
      const blockWidth = maxRowWidth * j;
      const blockX = k / 2 - blockWidth / 2;
      const topY = mobile ? 196 : 232;
      const baselineY = topY + glyphData.cap * j;
      const glyphX = (i) => blockX + glyphOffX[i] * j;
      const glyphY = (i) => baselineY + glyphOffY[i];
      const padX = mobile ? 10 : 14;
      const totalTextHeight = glyphData.cap * j + (numRows - 1) * rowHeight;
      const box = { x: blockX - padX, y: topY - 26, w: blockWidth + padX * 2, h: totalTextHeight + 26 + 22 };
      const boxCx = box.x + box.w / 2, boxCy = box.y + box.h / 2;
      const selectionMatrix = svg.getScreenCTM();
