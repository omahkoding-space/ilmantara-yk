      const pan = depth => prefersReducedMotion ? 'translate(0px, 0px)' : `translate(${-parallax.x * depth}px, ${-parallax.y * depth}px)`;

      // hover box + guides
      if (hoverBox && hoverBox.id !== "name") {
        hoverBoxG.style.opacity = 1;
        hoverRect.setAttribute("x", hoverBox.x - 1);
        hoverRect.setAttribute("y", hoverBox.y - 1);
        hoverRect.setAttribute("width", hoverBox.w + 2);
        hoverRect.setAttribute("height", hoverBox.h + 2);
      } else {
        hoverBoxG.style.opacity = 0;
      }
      renderGuides(editorWorking || hoverBox?.id === 'name' ? null : hoverBox, k, A);
      if (hoverBox) {
        hoverLabel.style.opacity = hoverBox.id === "name" ? 0 : 1;
        hoverLabel.setAttribute("x", hoverBox.x);
        hoverLabel.setAttribute("y", hoverBox.y - 8);
        setText(hoverLabel, hoverBox.label);
      } else {
        hoverLabel.style.opacity = 0;
      }

      // --- Layer panel + inspect panel highlight (desktop only) ---
      // These chrome panels fade in only after the name has settled (reference's `an`).
      const panelOpacity = EASE.expo(norm(D, L + 0.1, L + 1)); // Layers/Inspect: "an"
      const toolbarOpacity = EASE.expo(norm(D, 0, 0.6)); // Toolbar: "on" (fades in immediately, like the ruler)
      layersPanel.style.display = mobile ? "none" : "block";
      inspectPanel.style.display = mobile ? "none" : "block";
      toolbar.style.display = mobile ? "none" : "flex";
      layersPanel.style.opacity = panelOpacity * (1 - q);
      inspectPanel.style.opacity = panelOpacity * (1 - q);
      toolbar.style.opacity = toolbarOpacity * (1 - q);
      layersPanel.style.transform = `translateX(${(1 - panelOpacity) * -40 - q * 340}px) ${floatTransform('layers')}`;
      inspectPanel.style.transform = `translateX(${(1 - panelOpacity) * 40 + q * 340}px) ${floatTransform('inspect')}`;
      toolbar.style.top = `${A - 58 + (1 - toolbarOpacity) * 30}px`;
      if (!mobile) {
        const panelState = `${hovered}|${D < .35}|${D >= .35 && D < ORIGINAL_DURATION}|${D > 5 && D < 6.4}`;
        if (panelState !== lastPanelState) Object.entries(layerRows).forEach(([id, row]) => {
          const active = id === "frame" ? D < .35 : hovered ? id === hovered : id === "name" ? D >= .35 && D < ORIGINAL_DURATION : id === "comment" && D > 5 && D < 6.4;
          // The served rgb accent + hex-alpha suffix is invalid in the original;
          // match its actual transparent background, not an invented highlight.
          row.style.color = active ? ACCENT : "#0C0C0E";
          layerRowIcons[id].style.color = active ? ACCENT : "rgba(12,12,14,.55)";
        });
        lastPanelState = panelState;
        const activeBox = editor.isDragging() || editor.snapshot().phase === "restoring" ? boxes[0] : hoverBox || (D > L ? boxes[0] : null);
        if (activeBox) {
          setText(inspectName, activeBox.id === "name" ? "Name / vector" : activeBox.label);
          // Inspect panel shows coords relative to the ruler's zero point
          // (past the 20px corner gutter / 56px header), not raw canvas x/y.
          setText(inspectX, round(activeBox.x - 20));
          setText(inspectY, round(activeBox.y - 56));
          setText(inspectW, round(activeBox.w));
          setText(inspectH, round(activeBox.h));
        } else {
          setText(inspectName, "Nothing selected");
          for (const el of [inspectX, inspectY, inspectW, inspectH]) setText(el, "–");
        }
        setText(inspectFontSize, round(200 * M * editY));
        for (const id of ["ha-field-w", "ha-field-h", "ha-field-font"]) {
          const field = document.getElementById(id);
          field.style.background = resizing ? "rgba(16,179,122,.1)" : "";
          field.style.color = resizing ? "#10B37A" : "";
        }
        document.getElementById("ha-inspect-swatch").style.backgroundImage = "none";
        setText(document.getElementById("ha-inspect-fill"), "RGB(12, 12, 14)");
        setText(document.getElementById("ha-inspect-fill-detail"), "100%");

        if (tool !== lastTool) Object.entries(toolButtons).forEach(([id, btn]) => {
          btn.classList.add("transition-[background]", "duration-200", "cursor-none");
          const active = id === tool;
          btn.style.background = active ? ACCENT : "transparent";
          btn.querySelectorAll("svg path, svg circle").forEach((p) => p.setAttribute("stroke", active ? "#fff" : "#0C0C0E"));
        });
        lastTool = tool;
      }

      function renderGuides(hoverBox, k, A) {
        const key = hoverBox ? [hoverBox.id, k, A, ...boxes.flatMap(b => [b.id, round(b.x), round(b.y), round(b.w), round(b.h)])].join("|") : "none";
        if (key === lastGuideKey) return;
        lastGuideKey = key;
        if (!hoverBox) { guidesG.replaceChildren(); return; }
        const b = hoverBox;
        let left = 20, right = k, top = 56, bottom = A;
        const overlap = (a, b, c, d) => Math.min(b, d) - Math.max(a, c) > 0;
        for (const other of boxes.filter((other) => other !== b)) {
          if (overlap(b.y, b.y + b.h, other.y, other.y + other.h)) {
            if (other.x + other.w <= b.x) left = Math.max(left, other.x + other.w);
            if (other.x >= b.x + b.w) right = Math.min(right, other.x);
          }
          if (overlap(b.x, b.x + b.w, other.x, other.x + other.w)) {
            if (other.y + other.h <= b.y) top = Math.max(top, other.y + other.h);
            if (other.y >= b.y + b.h) bottom = Math.min(bottom, other.y);
          }
        }
        const cy = b.y + b.h / 2, cx = b.x + b.w / 2;
        const edges = [
          { v: b.x - left, line: [left, cy, b.x, cy] },
          { v: right - b.x - b.w, line: [b.x + b.w, cy, right, cy] },
          { v: b.y - top, line: [cx, top, cx, b.y] },
          { v: bottom - b.y - b.h, line: [cx, b.y + b.h, cx, bottom] },
        ];
        const setAttrs = (node, attrs) => { for (const [key, value] of Object.entries(attrs)) if (node.getAttribute(key) !== String(value)) node.setAttribute(key, value); };
        edges.forEach((e, index) => {
          const nodes = guidePool[index] ||= [
            ...Array.from({ length: 3 }, () => svgEl('line', { stroke: GUIDE_COLOR, 'stroke-width': 1 })),
            svgEl('rect', { width: 34, height: 18, rx: 4, fill: GUIDE_COLOR }),
            svgEl('text', { 'text-anchor': 'middle', fill: '#fff', 'font-size': 10, 'font-family': "'Geist Mono', monospace", 'font-weight': 500 }),
          ];
          if (e.v <= 2) { nodes.forEach(n => n.remove()); return; }
          if (!nodes[0].isConnected) guidesG.append(...nodes);
          const [x1, y1, x2, y2] = e.line, horizontal = y1 === y2;
          setAttrs(nodes[0], { x1, y1, x2, y2 });
          [[x1, y1], [x2, y2]].forEach(([x, y], i) => setAttrs(nodes[i + 1], { x1: x - (horizontal ? 0 : 4), y1: y - (horizontal ? 4 : 0), x2: x + (horizontal ? 0 : 4), y2: y + (horizontal ? 4 : 0) }));
          const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
          setAttrs(nodes[3], { x: mx - 17, y: my - 9 });
          setAttrs(nodes[4], { x: mx, y: my + 4 }); setText(nodes[4], round(e.v));
        });
      }

      function canvasScaleForDom() { return s; }
    }

    // All these elements are children of #ha-canvas, which already carries
    // the scale()/left/top transform for the whole canvas — so children are
    // positioned in raw canvas-space px, not screen px. Only the mouse
    // (which arrives in real screen px from pointermove) needs the manual
    // (screenPx - origin) / s conversion before being used here.
    function positionAbs(el, x, y, alignRight) {
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.transform = alignRight ? `translateX(-100%)` : "";
    }

    function GatedReply(D, L) { return D > L + BEATS.replyBackStart; }

    function fadeIn(D, start) {
      const o = EASE.out(norm(D, start, start + 0.8));
      return { o, dy: (1 - o) * 16, blur: (1 - o) * 6 };
    }

    function requestFrame() { if (!rafId && !abort.signal.aborted && !document.hidden) rafId = requestAnimationFrame(frame); }
    function frame() {
      rafId = 0;
      const D = debugTime !== null ? debugTime : (performance.now() - startTime) / 1000;
      // Only animate while the hero is actually on screen. The intro is
      // 25 s long, so the old `!visible && D > TOTAL_DURATION` guard kept a
      // full-scene render running every frame for the first 25 s even after
      // the hero had been scrolled far out of view — that stole main-thread
      // time from every scroll further down the page. The IntersectionObserver
      // (re)starts the loop via requestFrame() when the hero comes back.
      if (!visible || document.hidden) return;
      const state = editor.snapshot();
      if (prefersReducedMotion && D > TOTAL_DURATION + 1 && debugTime === null && !state.dirty && !editor.isDragging() && !editor.isLocked()) return;
      render(D); requestFrame();
    }
    document.addEventListener('visibilitychange', requestFrame, { signal: abort.signal });

    container.addEventListener("pointermove", (e) => {
      const rect = container.getBoundingClientRect();
      mouseScreen = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      if (prefersReducedMotion) render(lastTime);
    }, { signal: abort.signal });
    container.addEventListener("pointerleave", () => { mouseScreen = null; if (prefersReducedMotion) render(lastTime); }, { signal: abort.signal });
    const resize = new ResizeObserver(() => render(lastTime));
    resize.observe(container);
    const contentResize = new ResizeObserver(() => { contentLayout.key = null; render(lastTime); });
    contentResize.observe(statement); contentResize.observe(cta);
    // Scroll drives the hero's exit transition, but frame() already re-renders
    // every frame while the hero is on screen — so scrolling only needs to make
    // sure the loop is running. requestFrame() is a no-op while it is (guarded
    // by rafId), which avoids scheduling a second full render per frame.
    window.addEventListener("scroll", requestFrame, { passive: true, signal: abort.signal });

    const heroApi = {
      ready: Promise.resolve(true),
      render: (t, p = 0, x, y) => {
        debugTime = t; debugScroll = clamp(p);
        if (x !== undefined && y !== undefined && x !== null && x >= 0) mouseScreen = { x, y };
        else if (x !== undefined) mouseScreen = null;
        render(t);
      },
      resume: () => { debugTime = null; debugScroll = null; requestFrame(); },
      state: () => ({ time: lastTime, reducedMotion: prefersReducedMotion, visible }),
      editor: () => editor.snapshot(),
    };
    window.__ilmantaraHero = heroApi;
    function dispose() {
      if (window.__ilmantaraHero === heroApi) delete window.__ilmantaraHero;
      editor.dispose(); cancelAnimationFrame(rafId); abort.abort(); resize.disconnect(); contentResize.disconnect(); visibility.disconnect();
      delete container.dataset.haInitialized;
    }
    window.addEventListener("pagehide", dispose, { once: true, signal: abort.signal });
    document.addEventListener("astro:before-swap", dispose, { once: true, signal: abort.signal });
    render(lastTime);
    requestFrame();
  }

  // `astro:page-load` fires on the initial load and on every client-side
  // transition navigation — DOMContentLoaded only fires once, so re-entering
  // this page via the ClientRouter (e.g. journal -> beranda) never re-ran
  // init() and left the hero canvas empty.
  document.addEventListener("astro:page-load", init);
</script>
