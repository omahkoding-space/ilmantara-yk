---
import { WORK } from "../../data/work";
import Img from "../Img.astro";
import { LINK_UNDERLINE } from "../../lib/styles";

// Cards link to the internal case-study page; the live site is reached via the
// "Kunjungi Proyek Live" CTA on that page instead of navigating straight out.
const CASES = WORK.map((p) => ({
  name: p.name,
  title: p.title,
  href: `/work/${p.slug}/`,
  tag: p.category,
  year: p.year,
  summary: p.summary,
  img: p.cover,
  imgAlt: p.coverAlt,
}));
---

<section data-framer-name="02 Case studies" class="bg-paper">
  <div class="mx-auto grid max-w-[1312px] grid-cols-1 gap-x-8 gap-y-[72px] px-5 pb-[87px] pt-10 sm:px-8 md:grid-cols-1 lg:grid-cols-2 lg:px-16 lg:pb-[140px]">
    {CASES.map((c, i) => (
      <a
        href={c.href}
        title={c.title}
        class="group block text-ink"
      >
        <!-- canvas label -->
        <div class="mb-2.5 flex items-center justify-between font-mono text-[11px] font-medium uppercase tracking-[0.04em] text-ink/65">
          {c.year && <span>#{c.year}</span>}
          <span>{c.tag}</span>
        </div>

        <!-- project image -->
        <div class="relative aspect-[8/5]">
          <div class="absolute inset-0 overflow-hidden">
            <Img
              src={c.img}
              alt={c.imgAlt}
              title={c.imgAlt}
              sizes="(min-width: 1024px) 45vw, 100vw"
              loading={i === 0 ? undefined : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              class="absolute inset-0 h-full w-full scale-[1.06] object-cover object-top transition-all duration-700 ease-out group-hover:scale-[1.03] group-hover:blur-[2px]"
            />
            <span class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 scale-90 items-center justify-center rounded-full bg-white text-accent opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
              <svg width="18" height="18" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M3.5 10.5L10.5 3.5M5 3.5h5.5V9" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <!-- selection frame: blue border + white handles -->
          <span class="absolute inset-0 border-[1.5px] border-accent"></span>
          <!-- handles: top-left, top-center, top-right, mid-right, bottom-right, bottom-center, bottom-left, mid-left -->
          <span class="absolute left-0 top-0 h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-1/2 top-0 h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-full top-0 h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-full top-1/2 h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-full top-full h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-1/2 top-full h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-0 top-full h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
          <span class="absolute left-0 top-1/2 h-[11px] w-[11px] -translate-x-1/2 -translate-y-1/2 border-[1.5px] border-accent bg-white"></span>
        </div>

        <!-- meta -->
        <div class="mt-4">
          <h2 class={`${LINK_UNDERLINE} text-[20px] font-semibold tracking-[-0.01em] text-ink transition-colors duration-300 group-hover:text-accent`}>{c.title}</h2>
          <p class="mt-2 max-w-[480px] text-[15px] leading-[1.55] text-ink/60">{c.summary}</p>
        </div>
      </a>
    ))}
  </div>
</section>
